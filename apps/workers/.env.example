# ==============================================================================
# BuildMarket Background Workers Daemon Environment Configuration (.env.example)
# ==============================================================================

# Runtime Environment
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Database Connection (Required)
# Must start with postgresql:// or postgres://
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buildmarket?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/buildmarket?schema=public
DB_POOL_MAX=5

# Redis / BullMQ Connection (Required)
# Must start with redis:// or rediss://
REDIS_URL=redis://localhost:6379

# NATS JetStream Connection
# Required in production; defaults to nats://localhost:4222 in development
NATS_URL=nats://localhost:4222

# Health Server & Orchestrator Probes
HEALTH_PORT=8080

# Emergency Dormant Switch (Set to true to disable background job consumption)
DISABLE_BACKGROUND_JOBS=false

# ==============================================================================
# Storage / S3 / R2 Configuration (GDPR Data Export Processor)
# ==============================================================================
# Set S3_DISABLED=true to use local storage filesystem in development
S3_DISABLED=true
R2_EXPORT_BUCKET=buildmarket-exports
S3_EXPORT_BUCKET=buildmarket-exports
EXPORTS_BUCKET_NAME=buildmarket-exports

# S3 / Cloudflare R2 Credentials & Endpoints (Required when S3_DISABLED=false)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto

# AWS S3 Fallback Credentials & Endpoints
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_URL=https://s3.amazonaws.com

# ==============================================================================
# Email & Regulatory Compliance Contacts
# ==============================================================================
# Resend API Key for export completion emails and incident notices
RESEND_API_KEY=re_123456789

# Data Protection & Regulatory Notification Recipients
ODPC_EMAIL=dpo@odpc.go.ke
DPO_EMAIL=security@buildmarket.app
