# ==============================================================================
# BuildMarket Background Workers Daemon Environment Configuration (.env.example)
# ==============================================================================

# Runtime Environment
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Database Connection (Required)
# Must start with postgresql:// or postgres://
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buildmarket?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/buildmarket?schema=public
DB_POOL_MAX=5

# Redis / BullMQ Connection (Required when using Redis backend)
# Must start with redis:// or rediss://
REDIS_URL=redis://localhost:6379

# ==============================================================================
# BullMQ Backend & Canary Rollout Configuration (Redis → PostgreSQL)
# ==============================================================================
# Global default queue backend: "redis" or "postgres" (default: redis)
QUEUE_BACKEND=redis

# Optional: Granular per-queue backend overrides for 3-tier canary rollout:
# Tier 1 (Low Stakes Canary):
# QUEUE_BACKEND_MAINTENANCE_JOBS=postgres
# QUEUE_BACKEND_NOTIFICATION_RETRIES=postgres

# Tier 2 (Medium Stakes):
# QUEUE_BACKEND_NEWSLETTER_CONFIRMATION_EMAIL=postgres
# QUEUE_BACKEND_NEWSLETTER_ESP_SYNC=postgres
# QUEUE_BACKEND_GDPR_DATA_EXPORT=postgres
# QUEUE_BACKEND_UPLOADS_IMAGE_PROCESSING=postgres

# Tier 3 (High Stakes / Financials & Compliance):
# QUEUE_BACKEND_SECURITY_INCIDENTS=postgres
# QUEUE_BACKEND_COMPLIANCE_NOTIFICATIONS=postgres
# QUEUE_BACKEND_AUDIT_LOGS=postgres
# QUEUE_BACKEND_LICENSE_VERIFICATION=postgres
# QUEUE_BACKEND_MPESA_PAYMENTS=postgres
# QUEUE_BACKEND_MPESA_RECONCILIATION=postgres

# NATS JetStream Connection
# Required in production; defaults to nats://localhost:4222 in development
# In production on Render connecting to AKS, use: tls://nats.buildmarket.io:4222
NATS_URL=nats://localhost:4222
# NATS Authentication Token (Required when NATS cluster has auth enabled)
NATS_TOKEN=

# Health Server & Orchestrator Probes
HEALTH_PORT=8080

# Emergency Dormant Switch (Set to true to disable background job consumption)
DISABLE_BACKGROUND_JOBS=false

# ==============================================================================
# M-Pesa Daraja Integration Configuration (Strictly Worker Daemon Boundary)
# ==============================================================================
# Global kill switch for M-Pesa processing (STK initiate & reconciliation)
MPESA_ENABLED=false
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97ddafsti615rsde2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://api.buildmarket.app/api/webhooks/mpesa/stk-callback

# B2C Disbursements & Payouts (Requires MPESA_ENABLED=true)
MPESA_B2C_ENABLED=false
MPESA_B2C_INITIATOR_NAME=testapi
MPESA_B2C_INITIATOR_PASSWORD=your-b2c-initiator-password
MPESA_B2C_CERTIFICATE_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
MPESA_B2C_RESULT_URL=https://api.buildmarket.app/api/webhooks/mpesa/b2c-result
MPESA_B2C_TIMEOUT_URL=https://api.buildmarket.app/api/webhooks/mpesa/b2c-timeout

# ==============================================================================
# Storage / S3 / R2 Configuration (GDPR Data Export Processor)
# ==============================================================================
# Set S3_DISABLED=true to use local storage filesystem in development
S3_DISABLED=true
R2_EXPORT_BUCKET=buildmarket-exports
S3_EXPORT_BUCKET=buildmarket-exports
EXPORTS_BUCKET_NAME=buildmarket-exports

# S3 / Cloudflare R2 Credentials & Endpoints (Required when S3_DISABLED=false)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto

# AWS S3 Fallback Credentials & Endpoints
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_URL=https://s3.amazonaws.com

# ==============================================================================
# Email & Regulatory Compliance Contacts
# ==============================================================================
# Resend API Key for export completion emails and incident notices
RESEND_API_KEY=re_123456789

# Data Protection & Regulatory Notification Recipients
ODPC_EMAIL=dpo@odpc.go.ke
DPO_EMAIL=security@buildmarket.app

# ==============================================================================
# Malware Scanner & Image Processing Configuration
# ==============================================================================
# Cloudmersive Virus Scanner API Key (Required for production upload scanning)
CLOUDMERSIVE_API_KEY=
CLOUDMERSIVE_BASE_URL=https://api.cloudmersive.com
ALLOW_MOCK_VIRUS_SCANNER=false

# Emergency Rollback Switch for Image Processing (defaults to true if omitted)
WORKER_IMAGE_PROCESSING_ENABLED=true

# ==============================================================================
# OpenTelemetry & Datadog APM Configuration (dd-trace)
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=build-market-workers
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,service.version=local
DD_API_KEY=
DD_SITE_HOST=us5.datadoghq.com
DD_ENV=staging
DD_SERVICE=build-market-workers
DD_VERSION=1.0.0
DD_AGENT_HOST=127.0.0.1
DD_TRACE_ENABLED=true


