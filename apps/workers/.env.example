# ==============================================================================
# BuildMarket Background Workers Environment Contract (apps/workers)
# ==============================================================================

# Node Runtime Environment ('development' | 'test' | 'production')
NODE_ENV=development

# PostgreSQL Connection String (Supavisor pooled endpoint or local docker-compose Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buildmarket?schema=public

# Optional: Direct PostgreSQL Connection URL (bypassing pooler for migration inspection)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/buildmarket?schema=public

# Redis Connection URL (TCP endpoint required for BullMQ — e.g. local Docker or Upstash TCP)
REDIS_URL=redis://localhost:6379

# NATS JetStream Cluster URL
NATS_URL=nats://localhost:4222

# Maximum persistent PostgreSQL connection pool size for this worker replica (Default: 5, Max: 20)
DB_POOL_MAX=5

# HTTP Health & Liveness Probe Port for orchestrators and Docker HEALTHCHECK (Default: 8080)
HEALTH_PORT=8080

# Emergency Brake: Set to 'true' to keep worker daemon alive while halting queue consumption
DISABLE_BACKGROUND_JOBS=false

# Structured Logger Output Level ('trace' | 'debug' | 'info' | 'warn' | 'error' | 'fatal')
LOG_LEVEL=info
