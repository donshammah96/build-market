{
  "extends": "@build/typescript-config/nextjs.json",
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/domains/*": ["./app/lib/domains/*"],
      "@/infra/*": ["./app/lib/infrastructure/*"],
      "@/security/*": ["./app/lib/security/*"],
      "@/config/*": ["./app/lib/config/*"],
      "@/validation/*": ["./app/lib/validation/*"],
      "@/ui/*": ["./components/*"],
      "@/facades/*": ["./lib/facades/*"],
      "@/routes": ["./lib/routes/index"],
      "@/api/*": ["./app/lib/api/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "docs", ".next", ".next/**/*"],
  "references": [
    { "path": "../../packages/resilience" },
    { "path": "../../packages/db" },
    { "path": "../../packages/types" },
    { "path": "../../packages/enums" },
    { "path": "../../packages/redis" },
    { "path": "../../packages/nats" },
    { "path": "../../packages/auth-server" },
    { "path": "../../packages/mail-server" },
    { "path": "../../packages/messaging-server" },
    { "path": "../../packages/queue-server" },
    { "path": "../../packages/ui" },
    { "path": "../../packages/security-clerk" },
    { "path": "../../packages/env-validation" }
  ]
}
