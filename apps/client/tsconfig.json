{
  "extends": "@build/typescript-config/nextjs.json",
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/domains/*": ["./app/lib/domains/*"],
      "@/infra/*": ["./app/lib/infrastructure/*"],
      "@/security/*": ["./app/lib/security/*"],
      "@/config/*": ["./app/lib/config/*"],
      "@/validation/*": ["./app/lib/validation/*"],
      "@/ui/*": ["./components/*"],
      "@/facades/*": ["./lib/facades/*"],
      "@/routes": ["./lib/routes/index"],
      "@/api/*": ["./app/lib/api/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "docs", ".next"]
}
