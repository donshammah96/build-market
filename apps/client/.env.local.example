# ============================================
# Build Market - Local Overrides Template
# ============================================
# Copy to .env.local for personal settings
# This file overrides .env and .env.development
# NEVER commit .env.local!
# ============================================

# Override any setting from .env or .env.development here
# Examples:

# Use a different database
# DATABASE_URL="postgresql://myuser:mypass@localhost:5432/mydb"

# Use different ports
# NEXT_PUBLIC_APP_URL=http://localhost:3001
# REDIS_PORT=6380
# REDIS_FAMILY=4

# Enable/disable features for local testing
# ENABLE_NOTIFICATION_SERVICE=false
# S3_DISABLED=true
# NEXT_PUBLIC_ENABLE_GENERIC_PROJECTS_API=true
# NEXT_PUBLIC_ENABLE_GENERIC_PROJECTS_API_MUTATIONS=true

# Override batch sizes for faster testing
# CLEANUP_BATCH_SIZE=10
# ANONYMIZATION_BATCH_SIZE=5

# ============================================
# Offline Dev Auth Bypass (Local Only)
# ============================================
# WARNING: For local development only.
# Must remain disabled in CI/preview/production.
# BYPASS_AUTH is hard-blocked outside localhost development requests.

# BYPASS_AUTH=false
# DEV_CLERK_ID=user_local_dev
# DEV_DB_USER_ID=00000000-0000-0000-0000-000000000000
# DEV_USER_EMAIL=developer@example.com
# DEV_USER_ROLE=PROFESSIONAL
