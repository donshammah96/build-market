# ============================================
# Build Market - Development Defaults
# ============================================
# This file contains NON-SECRET development defaults
# Committed to version control
# Override with .env.local for personal settings
# ============================================

# Application
NODE_ENV=development

# URLs (Development)
NEXT_PUBLIC_APP_URL=http://localhost:3500
NEXT_PUBLIC_API_URL=http://localhost:3500/api
AUTH_URL=http://localhost:3500/api/auth
NEXTAUTH_URL=http://localhost:3500
NEXT_PUBLIC_SEARCH_SERVICE_URL=http://localhost:3005

# Clerk Routes
 NEXT_PUBLIC_CLERK_FRONTEND_API=http://localhost:3500   
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Internal Services (Development URLs)
MESSAGING_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011

# Queue Provider (use MEMORY for local dev, REDIS for production)
QUEUE_PROVIDER=MEMORY

# Redis (Local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TLS=false
REDIS_MAX_RETRIES_PER_REQUEST=5
REDIS_CONNECT_TIMEOUT=10000

# NATS (Local)
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=buildmarket-dev
NATS_CLIENT_NAME=client-app

# S3 (Disabled for local dev)
S3_DISABLED=true
EXPORT_LOCAL_DIR=./temp-exports
AWS_REGION=af-south-1

# Feature Flags (Development)
ENABLE_NOTIFICATION_SERVICE=true
ENABLE_GDPR_FEATURES=true
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true
NEXT_PUBLIC_ENABLE_GENERIC_PROJECTS_API=true
NEXT_PUBLIC_ENABLE_GENERIC_PROJECTS_API_MUTATIONS=false

# GDPR Settings
EXPORT_EXPIRY_HOURS=48
DELETION_GRACE_PERIOD_DAYS=30
ENCRYPTION_MIGRATION_MODE=false
CURRENT_KEY_VERSION=v1

# Scheduler (Development - run frequently for testing)
EXPORT_CLEANUP_CRON=0 2 * * *
DATA_RETENTION_CRON=0 3 * * *
ANONYMIZATION_BATCH_CRON=0 4 * * *
ASSET_CLEANUP_CRON=0 5 * * *
CLEANUP_BATCH_SIZE=100
ANONYMIZATION_BATCH_SIZE=50
RETENTION_BATCH_SIZE=100

# Misc
DRAFT_STORAGE_KEY=professional-profile-draft
