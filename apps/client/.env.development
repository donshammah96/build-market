# ============================================
# Build Market - Development Defaults
# ============================================
# This file contains NON-SECRET development defaults.
# Committed to version control.
# Override with .env.local for personal settings (gitignored).
# ============================================

# Application
NODE_ENV=development
ANALYZE=false

# URLs (Development)
NEXT_PUBLIC_APP_URL=http://localhost:3500
NEXT_PUBLIC_API_URL=http://localhost:3500/api
NEXT_PUBLIC_SEARCH_SERVICE_URL=http://localhost:3005
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3005

# Clerk Routes
# FIX: removed the leading space and incorrect localhost URL that was here.
# NEXT_PUBLIC_CLERK_FRONTEND_API must match your Clerk dashboard instance URL
# (e.g. https://your-instance.accounts.dev). Override in .env.local or .env.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Safety net only. Auth entry points explicitly use forceRedirectUrl, but keep
# Clerk env fallbacks aligned to the auth callback if they are ever consulted.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth-callback
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth-callback
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Internal Services (Development URLs)
MESSAGING_SERVICE_URL=http://localhost:3010
NEXT_PUBLIC_MESSAGING_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011

# Queue Provider (use MEMORY for local dev, REDIS for production)
QUEUE_PROVIDER=MEMORY

# Redis (Local) — override in .env.local if you run Redis locally
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TLS=false
REDIS_ENABLED=true
RATE_LIMIT_BACKEND=auto

# NATS (Local)
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=buildmarket-dev
NATS_CLIENT_NAME=client-app

# S3 (Disabled for local dev)
S3_DISABLED=true
STORAGE_PROVIDER=local
UPLOAD_DIR=./public/uploads
CDN_URL=/uploads
EXPORT_LOCAL_DIR=./temp-exports
AWS_REGION=af-south-1
UPLOAD_PROCESS_INLINE=false

# Feature Flags (Development)
ENABLE_NOTIFICATION_SERVICE=true
ENABLE_GDPR_FEATURES=true
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true

# GDPR Settings
EXPORT_EXPIRY_HOURS=48
DELETION_GRACE_PERIOD_DAYS=30
ENCRYPTION_MIGRATION_MODE=false
CURRENT_KEY_VERSION=v1

# Webhook replay defaults
CLERK_WEBHOOK_REPLAY_WINDOW_SECONDS=300
CLERK_WEBHOOK_PROCESSING_TTL_SECONDS=120
CLERK_WEBHOOK_PROCESSED_TTL_SECONDS=86400

# Scheduler (development defaults)
EXPORT_CLEANUP_CRON=0 2 * * *
DATA_RETENTION_CRON=0 3 * * *
ANONYMIZATION_BATCH_CRON=0 4 * * *
ASSET_CLEANUP_CRON=0 5 * * *
ONBOARDING_UPLOAD_CLEANUP_CRON=0 3 * * *
CLEANUP_BATCH_SIZE=100
ANONYMIZATION_BATCH_SIZE=50
RETENTION_BATCH_SIZE=100

# Analytics (disabled in dev by default — override in .env.local to enable)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Misc
DRAFT_STORAGE_KEY=professional-profile-draft
APP_URL=http://localhost:3500
