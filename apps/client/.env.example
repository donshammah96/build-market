# ============================================
# Build Market - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets!
# 
# File Loading Order (Next.js):
#   .env.local → .env.[environment] → .env
#
# File Structure:
#   .env           - Your local secrets (gitignored)
#   .env.local     - Local overrides (gitignored)
#   .env.example   - This template (committed)
#   .env.development - Dev defaults (committed)
#   .env.test      - Test config (committed)
# ============================================

# ============================================
# Clerk Authentication (Required)
# Get from: https://dashboard.clerk.com
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"
CLERK_SECRET_KEY="sk_test_your_secret_key"
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Clerk Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ============================================
# Auth Configuration (Required)
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your_auth_secret_here"
AUTH_URL="http://localhost:3500/api/auth"

# ============================================
# OAuth Providers (Optional)
# ============================================
# Google: https://console.developers.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_URL="http://localhost:3500"

# Auth0: https://manage.auth0.com
APP_BASE_URL=http://localhost:3500
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
AUTH0_SECRET=""


# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Facebook: https://developers.facebook.com
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Microsoft Azure AD
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# ============================================
# Database (Required)
# ============================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://username:password@localhost:5434/buildmarket"

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3500
NEXT_PUBLIC_API_URL=http://localhost:3500/api
NEXT_PUBLIC_SEARCH_SERVICE_URL=http://localhost:3005
# Server-side canonical app URL used by worker notifications
APP_URL=http://localhost:3500

# ============================================
# Internal Services
# ============================================
MESSAGING_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011
ENABLE_NOTIFICATION_SERVICE=true
QUEUE_PROVIDER="MEMORY"

# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET="your_internal_api_secret"

# ============================================
# Email Service
# ============================================
# Resend (Recommended): https://resend.com
RESEND_API_KEY=""

# SMTP Alternative
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=""
SMTP_FROM=noreply@yourdomain.com

# ============================================
# Redis (Required)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Optional Redis Configuration
REDIS_KEY_PREFIX=""
REDIS_TLS=false
# Force IPv4 locally if dual-stack DNS prefers an unreachable IPv6 path
REDIS_FAMILY=4
REDIS_MAX_RETRIES_PER_REQUEST=5
REDIS_CONNECT_TIMEOUT=10000

# Upstash Redis (Serverless Alternative)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================
# NATS Messaging
# ============================================
NATS_URL="nats://localhost:4222"
NATS_CLUSTER_ID="buildmarket-cluster"
NATS_CLIENT_ID="client-app-01"
NATS_CLIENT_NAME="client-app"
NATS_TOKEN=""
NATS_USER=""
NATS_PASS=""
NATS_MAX_RECONNECT_ATTEMPTS=-1
NATS_RECONNECT_TIME_WAIT=2000
NATS_TIMEOUT=10000

# ============================================
# Security
# ============================================
# hCaptcha: https://dashboard.hcaptcha.com
HCAPTCHA_SECRET_KEY=""

# AI Services
NEXT_PUBLIC_GEMINI_API_KEY=""

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ============================================
# AWS S3 (File Uploads/Exports)
# ============================================
# Set to 'true' for local development
S3_DISABLED=true

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=af-south-1
S3_EXPORT_BUCKET=buildmarket-exports
EXPORTS_BUCKET_NAME=buildmarket-gdpr-exports
EXPORT_LOCAL_DIR=./temp-exports
S3_ASSET_BUCKET=buildmarket-assets

# Storage Provider Compatibility (used by infrastructure/storage)
STORAGE_PROVIDER=local
UPLOAD_DIR=./public/uploads
STORAGE_BUCKET=""
STORAGE_REGION=af-south-1
CDN_URL=/uploads

# ============================================
# Encryption (Required)
# ============================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY_V1=""
ENCRYPTION_KEY_V2=""
# Legacy fallback key for backward-compatible decryption paths
ENCRYPTION_KEY=""
ENCRYPTION_KEY_V3=""
ENCRYPTION_KEY_V4=""
ENCRYPTION_KEY_V5=""
CURRENT_KEY_VERSION=v1
ENCRYPTION_MIGRATION_MODE=false
LEGACY_FORMAT_DEADLINE=""
ROTATION_BATCH_SIZE=100

# ============================================
# GDPR Compliance
# ============================================
ODPC_EMAIL=dpo@odpc.go.ke
DPO_EMAIL=dpo@yourdomain.com
EXPORT_EXPIRY_HOURS=48
DELETION_GRACE_PERIOD_DAYS=30

# ============================================
# SMS Service (Optional)
# ============================================
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=""
AFRICASTALKING_SENDER_ID=BuildMarket

# ============================================
# Scheduler Configuration
# ============================================
EXPORT_CLEANUP_CRON=0 2 * * *
DATA_RETENTION_CRON=0 3 * * *
ANONYMIZATION_BATCH_CRON=0 4 * * *
ASSET_CLEANUP_CRON=0 5 * * *
ONBOARDING_UPLOAD_CLEANUP_CRON=0 3 * * *
CLEANUP_BATCH_SIZE=100
EXPORT_CLEANUP_BATCH_SIZE=100
EXPORT_CLEANUP_MAX_RETRIES=3
ANONYMIZATION_BATCH_SIZE=50
RETENTION_BATCH_SIZE=100

# ============================================
# Feature Flags
# ============================================
ENABLE_GDPR_FEATURES=true
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true

# Generic Projects API rollout gates
# Read endpoints: /api/projects/**
NEXT_PUBLIC_ENABLE_GENERIC_PROJECTS_API=true
# Mutation endpoints (POST/PATCH/DELETE)
NEXT_PUBLIC_ENABLE_GENERIC_PROJECTS_API_MUTATIONS=true

# ============================================
# Development Only
# ============================================
NODE_ENV=development
DRAFT_STORAGE_KEY="professional-profile-draft"

# Optional local-only auth bypass controls (never enable in CI/production)
BYPASS_AUTH=false
DEV_CLERK_ID=user_local_dev
DEV_DB_USER_ID=00000000-0000-0000-0000-000000000000
DEV_USER_EMAIL=developer@example.com
DEV_USER_ROLE=PROFESSIONAL

# Optional compatibility path used by app/lib/infrastructure/db.ts
POSTGRES_URL=""

# Optional client-side messaging override for socket bootstrap
NEXT_PUBLIC_MESSAGING_SERVICE_URL="http://localhost:3010"
