# ============================================
# Build Market - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files containing real secrets.
#
# Next.js file loading order (highest priority first):
#   .env.local → .env.[NODE_ENV] → .env
#
# File roles:
#   .env             — Your local secrets (gitignored)
#   .env.local       — Personal overrides (gitignored)
#   .env.example     — This template (committed, no secrets)
#   .env.development — Non-secret dev defaults (committed)
#   .env.test        — Test configuration (committed, no real secrets)
#   .env.vercel.example — Production/Vercel template (committed, no secrets)
# ============================================

# ============================================
# Clerk Authentication [REQUIRED]
# Get keys from: https://dashboard.clerk.com
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"
CLERK_SECRET_KEY="sk_test_your_secret_key"
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Clerk frontend API and redirect routes
NEXT_PUBLIC_CLERK_FRONTEND_API="https://your-instance.accounts.dev"
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_UNAUTHORIZED_SIGN_IN=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ============================================
# Auth [REQUIRED]
# Generate with: openssl rand -base64 32
# ============================================
AUTH_SECRET="your_auth_secret_here"

# ============================================
# OAuth Providers [OPTIONAL]
# ============================================
# Google: https://console.developers.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Facebook: https://developers.facebook.com
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Microsoft Azure AD
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# ============================================
# Database [REQUIRED]
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5434/buildmarket"

# Vercel Postgres alias (auto-injected by Vercel Postgres integration)
POSTGRES_URL=""

# ============================================
# Application URLs [REQUIRED]
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3500
NEXT_PUBLIC_API_URL=http://localhost:3500/api
NEXT_PUBLIC_SEARCH_SERVICE_URL=http://localhost:3005

# Server-side canonical URL (used by worker notifications)
APP_URL=http://localhost:3500

# CORS and CSRF policies (comma-separated origins)
CORS_ALLOWED_ORIGINS=""
CSRF_TRUSTED_ORIGINS=""
CORS_DEV_ALLOWED_ORIGINS=""

# ============================================
# Internal Services
# ============================================
MESSAGING_SERVICE_URL=http://localhost:3010
NEXT_PUBLIC_MESSAGING_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011
ENABLE_NOTIFICATION_SERVICE=true
QUEUE_PROVIDER="MEMORY"

# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET="your_internal_api_secret"

# ============================================
# Email Service [OPTIONAL]
# Resend (recommended): https://resend.com
# ============================================
RESEND_API_KEY=""
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=""
SMTP_FROM=noreply@yourdomain.com

# ============================================
# Redis [REQUIRED FOR PRODUCTION RATE LIMITING]
# Option A — Upstash REST (recommended for Vercel): set UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# Option B — Connection URL: set REDIS_URL
# Option C — Host/port: set REDIS_HOST + REDIS_PORT
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Upstash REST API (serverless-friendly, recommended for Vercel)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Redis tunables
REDIS_KEY_PREFIX=""
REDIS_TLS=false
REDIS_FAMILY=4
REDIS_MAX_RETRIES_PER_REQUEST=5
REDIS_CONNECT_TIMEOUT=10000
REDIS_REQUIRED_MAXMEMORY_POLICY=noeviction
# off | warn | error
REDIS_MAXMEMORY_POLICY_ENFORCEMENT=warn

# Rate limiter backend: auto | redis | memory
# auto = redis in production, memory in development
RATE_LIMIT_BACKEND=auto

# ============================================
# NATS Messaging [OPTIONAL]
# ============================================
NATS_URL="nats://localhost:4222"
NATS_CLUSTER_ID="buildmarket-cluster"
NATS_CLIENT_ID="client-app-01"
NATS_CLIENT_NAME="client-app"
NATS_TOKEN=""
NATS_USER=""
NATS_PASS=""
NATS_MAX_RECONNECT_ATTEMPTS=-1
NATS_RECONNECT_TIME_WAIT=2000
NATS_TIMEOUT=10000

# ============================================
# Security
# hCaptcha: https://dashboard.hcaptcha.com
# ============================================
HCAPTCHA_SECRET_KEY=""

# ============================================
# Analytics [OPTIONAL]
# PostHog: https://posthog.com
# ============================================
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ============================================
# AI / LLM Integrations [OPTIONAL]
# ============================================
NEXT_PUBLIC_GEMINI_API_KEY=""

# ============================================
# AWS S3 (File Uploads / Exports) [OPTIONAL]
# Set S3_DISABLED=true for local development.
# ============================================
S3_DISABLED=true
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=af-south-1
S3_ASSET_BUCKET=buildmarket-assets
S3_EXPORT_BUCKET=buildmarket-exports
EXPORTS_BUCKET_NAME=buildmarket-gdpr-exports
EXPORT_LOCAL_DIR=./temp-exports

# Storage provider compatibility
STORAGE_PROVIDER=local
STORAGE_BUCKET=""
STORAGE_REGION=af-south-1
UPLOAD_DIR=./public/uploads
CDN_URL=/uploads

# Upload processing (false = use worker queue; true = inline, dev/test only)
UPLOAD_PROCESS_INLINE=false
UPLOAD_STATUS_TTL_SECONDS=3600

# ============================================
# Webhook Replay Protection
# ============================================
CLERK_WEBHOOK_REPLAY_WINDOW_SECONDS=300
CLERK_WEBHOOK_PROCESSING_TTL_SECONDS=120
CLERK_WEBHOOK_PROCESSED_TTL_SECONDS=86400

# ============================================
# Encryption [REQUIRED]
# Generate with: openssl rand -hex 32
# Key must be 64 hex characters (32 bytes).
# ============================================
ENCRYPTION_KEY_V1=""
ENCRYPTION_KEY_V2=""
# Legacy fallback key (backward-compatible decryption only)
ENCRYPTION_KEY=""
CURRENT_KEY_VERSION=v1
ENCRYPTION_MIGRATION_MODE=false
LEGACY_FORMAT_DEADLINE=""
ROTATION_BATCH_SIZE=100

# ============================================
# GDPR Compliance
# ============================================
ODPC_EMAIL=dpo@odpc.go.ke
DPO_EMAIL=dpo@yourdomain.com
EXPORT_EXPIRY_HOURS=48
DELETION_GRACE_PERIOD_DAYS=30

# ============================================
# SMS Service [OPTIONAL]
# ============================================
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=""
AFRICASTALKING_SENDER_ID=BuildMarket

# ============================================
# Scheduler
# ============================================
EXPORT_CLEANUP_CRON=0 2 * * *
DATA_RETENTION_CRON=0 3 * * *
ANONYMIZATION_BATCH_CRON=0 4 * * *
ASSET_CLEANUP_CRON=0 5 * * *
ONBOARDING_UPLOAD_CLEANUP_CRON=0 3 * * *
CLEANUP_BATCH_SIZE=100
EXPORT_CLEANUP_BATCH_SIZE=100
EXPORT_CLEANUP_MAX_RETRIES=3
ANONYMIZATION_BATCH_SIZE=50
RETENTION_BATCH_SIZE=100

# ============================================
# Feature Flags
# ============================================
ENABLE_GDPR_FEATURES=true
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true

# ============================================
# Misc
# ============================================
DRAFT_STORAGE_KEY="professional-profile-draft"

# ============================================
# Development Only — NEVER enable in CI/production
# ============================================
NODE_ENV=development
BYPASS_AUTH=false
DEV_CLERK_ID=user_local_dev
DEV_DB_USER_ID=00000000-0000-0000-0000-000000000000
DEV_USER_EMAIL=developer@example.com
DEV_USER_ROLE=PROFESSIONAL

# Next.js runtime marker — DO NOT SET in Vercel environment variables.
# This is injected by the framework and manual assignment breaks edge detection.
# NEXT_RUNTIME=
