# ============================================
# Build Market - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files containing real secrets.
#
# Next.js file loading order (highest priority first):
#   .env.local → .env.[NODE_ENV] → .env
#
# File roles:
#   .env             — Your local secrets (gitignored)
#   .env.local       — Personal overrides (gitignored)
#   .env.example     — This template (committed, no secrets)
#   .env.development — Non-secret dev defaults (committed)
#   .env.test        — Test configuration (committed, no real secrets)
#   .env.vercel.example — Production/Vercel template (committed, no secrets)
# ============================================

# ============================================
# Clerk Authentication [REQUIRED]
# Get keys from: https://dashboard.clerk.com
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key"
CLERK_SECRET_KEY="sk_test_your_secret_key"
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret"
# Alternative alias key name for webhook secret:
# CLERK_WEBHOOK_SIGNING_SECRET="whsec_your_webhook_secret"

# Clerk frontend API and redirect routes
NEXT_PUBLIC_CLERK_FRONTEND_API="https://your-instance.accounts.dev"
NEXT_PUBLIC_CLERK_IS_SATELLITE="false"
NEXT_PUBLIC_CLERK_DOMAIN=""
NEXT_PUBLIC_CLERK_PRIMARY_SIGN_IN_URL=""
NEXT_PUBLIC_CLERK_SATELLITE_ORIGINS=""
# Set to "true" to emit Content-Security-Policy-Report-Only instead of Content-Security-Policy
NEXT_PUBLIC_CSP_REPORT_ONLY="false"
# Vercel environment flags and CSP unsafe-eval override
ENABLE_CSP_UNSAFE_EVAL="false"
VERCEL_ENV=""
NEXT_PUBLIC_VERCEL_ENV=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_UNAUTHORIZED_SIGN_IN=/sign-in
# Safety net only. Auth entry points explicitly use forceRedirectUrl, but keep
# Clerk env fallbacks aligned to the auth callback if they are ever consulted.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth-callback
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth-callback
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ============================================
# Auth [REQUIRED]
# Generate with: openssl rand -base64 32
# ============================================
AUTH_SECRET="your_auth_secret_here"
AUTH_DEV_BYPASS="false"

# ============================================
# OAuth Providers [OPTIONAL]
# ============================================
# Google: https://console.developers.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Facebook: https://developers.facebook.com
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Microsoft Azure AD
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# ============================================
# Database [REQUIRED]
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# ============================================
# Database [REQUIRED]
# Supabase: use the SESSION-MODE pooler URL for runtime.
# Get both URLs from: Supabase Dashboard → Project Settings → Database → Connection String
# ============================================

# Runtime — Supabase Supavisor session-mode pooler (safe for serverless / Next.js)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"

# Migrations only — direct connection, bypasses Supavisor (required for DDL)
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# NEVER used at Next.js runtime — only by: prisma migrate deploy / prisma migrate dev
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Vercel Postgres alias (auto-injected by Vercel Postgres integration, if used)
POSTGRES_URL=""

# ============================================
# Supabase [OPTIONAL — for Supabase SDK / Realtime, not required for Prisma-only use]
# ============================================
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."
# Server-side only — NEVER prefix with NEXT_PUBLIC_, bypasses Row Level Security
# Get from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=""

# Vercel Postgres alias (auto-injected by Vercel Postgres integration)
POSTGRES_URL=""

# ============================================
# Application URLs [REQUIRED]
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3500
NEXT_PUBLIC_CLIENT_APP_URL=http://localhost:3500
NEXT_PUBLIC_API_URL=http://localhost:3500/api
NEXT_PUBLIC_SEARCH_SERVICE_URL=http://localhost:3005
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3005
NEXT_PUBLIC_VERIFICATION_APP_URL=http://localhost:3501
NEXT_PUBLIC_VERIFICATION_OPS_URL=http://localhost:3501

# Server-side canonical URL (used by worker notifications)
APP_URL=http://localhost:3500
CLIENT_APP_URL=http://localhost:3500

# CORS and CSRF policies (comma-separated origins)
CORS_ALLOWED_ORIGINS=""
CSRF_TRUSTED_ORIGINS=""
CORS_DEV_ALLOWED_ORIGINS=""

# ============================================
# Internal Services
# ============================================
MESSAGING_SERVICE_URL=http://localhost:3010
NEXT_PUBLIC_MESSAGING_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011
ENABLE_NOTIFICATION_SERVICE=true
QUEUE_PROVIDER="MEMORY"

# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET="your_internal_api_secret"

# ============================================
# Email Service [OPTIONAL]
# Resend (recommended): https://resend.com
# ============================================
RESEND_API_KEY=""
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=""
SMTP_FROM=noreply@yourdomain.com

# ============================================
# Newsletter / Email Service Provider (ESP) [OPTIONAL]
# Powers the footer newsletter signup form.
# ESP_PROVIDER: 'resend' | 'mailchimp' | 'stub' (default — logs only, no network call)
# ESP_API_KEY: API key for the chosen provider. Server-side only. Never prefix NEXT_PUBLIC_.
# ESP_LIST_ID: Audience/List ID in the ESP to subscribe contacts to.
# Mailchimp: found in Audience > Audience settings > Audience ID
# Resend: found in Contacts > Audiences (audience ID) or Segments (segment ID)
# ============================================
ESP_PROVIDER="resend"
ESP_API_KEY=""
ESP_LIST_ID=""
RESEND_API_KEY=""
RESEND_SEGMENT_ID=""
RESEND_WEBHOOK_SECRET=""

# ============================================
# Redis / Upstash [REQUIRED FOR PRODUCTION RATE LIMITING]
# Primary transport: Upstash REST over HTTPS (serverless-safe, no TCP connections).
# BullMQ workers additionally need REDIS_URL (Upstash TCP endpoint).
# Get credentials from: https://console.upstash.com
# ============================================

# PRIMARY — Upstash REST credentials (required in production)
UPSTASH_REDIS_REST_URL="https://<db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# BullMQ TCP endpoint — required only for services running queue workers.
# Format: rediss://:TOKEN@<host>.upstash.io:6379
# The token is the same value as UPSTASH_REDIS_REST_TOKEN.
REDIS_URL="rediss://:TOKEN@<host>.upstash.io:6379"

# Rate limiter backend: auto | redis | memory
# auto = Upstash REST in production, in-process memory store in development
# (memory is used automatically when UPSTASH_REDIS_REST_URL is not set)
RATE_LIMIT_BACKEND=auto

# Optional Redis settings (not required for Upstash REST, BullMQ auto-configures from REDIS_URL)
DISABLE_BACKGROUND_JOBS=false

# ============================================
# DEPRECATED — Legacy Redis host/port/password fields
# These variables are no longer consulted by the Upstash REST client or the
# @upstash/ratelimit rate limiter. They are retained here for backward
# compatibility during the consumer migration period only.
# REMOVAL TARGET: next minor release after all BullMQ consumers are confirmed
#                 migrated to REDIS_URL and Upstash REST credentials.
# Track removal in: apps/client/docs/PROGRESS-SUMMARY.md § Deprecation Queue
# ============================================
# @deprecated — use UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN instead
REDIS_ENABLED=true
# @deprecated — use REDIS_URL (full connection URL) instead
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
# @deprecated — Upstash manages the IP family; not configurable via REST
REDIS_FAMILY=4
REDIS_TLS=false

# ============================================
# NATS Messaging [OPTIONAL]
# ============================================
NATS_URL="nats://localhost:4222"
NATS_CLUSTER_ID="buildmarket-cluster"
NATS_CLIENT_ID="client-app-01"
NATS_CLIENT_NAME="client-app"
NATS_TOKEN=""
NATS_USER=""
NATS_PASS=""
NATS_MAX_RECONNECT_ATTEMPTS=-1
NATS_RECONNECT_TIME_WAIT=2000
NATS_TIMEOUT=10000

# ============================================
# Security
# hCaptcha: https://dashboard.hcaptcha.com
# ============================================
HCAPTCHA_SECRET_KEY=""

# ============================================
# Analytics [OPTIONAL]
# PostHog: https://posthog.com
# ============================================
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ============================================
# AI / LLM Integrations [OPTIONAL]
# ============================================
NEXT_PUBLIC_GEMINI_API_KEY=""

# ============================================
# Regulator Verification APIs [OPTIONAL]
# Credentials for statutory authorities (EBK, BORAQS, NCA, EARB, VRB, ISK, EPRA).
# Absent values gracefully fall back to manual review.
# ============================================
REGULATOR_EBK_BASE_URL=""
REGULATOR_EBK_API_KEY=""
REGULATOR_EBK_SIGNING_SECRET=""

REGULATOR_BORAQS_BASE_URL=""
REGULATOR_BORAQS_API_KEY=""
REGULATOR_BORAQS_SIGNING_SECRET=""

REGULATOR_NCA_BASE_URL=""
REGULATOR_NCA_API_KEY=""
REGULATOR_NCA_SIGNING_SECRET=""

REGULATOR_EARB_BASE_URL=""
REGULATOR_EARB_API_KEY=""
REGULATOR_EARB_SIGNING_SECRET=""

REGULATOR_VRB_BASE_URL=""
REGULATOR_VRB_API_KEY=""
REGULATOR_VRB_SIGNING_SECRET=""

REGULATOR_ISK_BASE_URL=""
REGULATOR_ISK_API_KEY=""
REGULATOR_ISK_SIGNING_SECRET=""

REGULATOR_EPRA_BASE_URL=""
REGULATOR_EPRA_API_KEY=""
REGULATOR_EPRA_SIGNING_SECRET=""


# ============================================
# Cloudflare R2 (S3-Compatible File Uploads / Exports) [OPTIONAL]
# Canonical variables are R2_*.
# AWS_* and S3_* variables are temporary aliases and will be removed next release.
# Set S3_DISABLED=true for local development.
# ============================================
S3_DISABLED=true
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_REGION=auto
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ASSET_BUCKET=buildmarket-assets
R2_PRIVATE_BUCKET=buildmarket-private-assets
R2_EXPORT_BUCKET=buildmarket-exports
R2_PUBLIC_BASE_URL=https://cdn.example.com
EXPORT_LOCAL_DIR=./temp-exports
R2_BUCKET_STAGED="buildmarket-staged"
R2_BUCKET_VERIFIED_PRIVATE="buildmarket-verified-private"
R2_BUCKET_QUARANTINE="buildmarket-quarantine"
R2_SCAN_CALLBACK_URL="/api/internal/uploads/scan-callback"
APP_CALLBACK_URL="/api/internal/uploads/scan-callback"
ALLOW_MOCK_VIRUS_SCANNER="false"
CLOUDMERSIVE_API_KEY=""
SCAN_CALLBACK_HMAC_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Storage provider compatibility
STORAGE_PROVIDER=s3
UPLOAD_DIR=./public/uploads

# Legacy aliases (temporary fallback)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=af-south-1
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=af-south-1
S3_URL=""
S3_EU_URL=""
S3_ASSET_BUCKET=buildmarket-assets
S3_PRIVATE_BUCKET=buildmarket-private-assets
S3_EXPORT_BUCKET=buildmarket-exports
EXPORTS_BUCKET_NAME=buildmarket-gdpr-exports
STORAGE_BUCKET=""
STORAGE_REGION=af-south-1
CDN_URL=https://cdn.example.com

# Upload processing (false = use worker queue; true = inline, dev/test only)
UPLOAD_PROCESS_INLINE=false
UPLOAD_STATUS_TTL_SECONDS=3600

# ============================================
# Webhook Replay Protection
# ============================================
CLERK_WEBHOOK_REPLAY_WINDOW_SECONDS=300
CLERK_WEBHOOK_PROCESSING_TTL_SECONDS=120
CLERK_WEBHOOK_PROCESSED_TTL_SECONDS=86400

# ============================================
# Encryption [REQUIRED]
# Generate with: openssl rand -hex 32
# Key must be 64 hex characters (32 bytes).
# ============================================
ENCRYPTION_KEY_V1=""
ENCRYPTION_KEY_V2=""
ENCRYPTION_KEY_V3=""
ENCRYPTION_KEY_V4=""
ENCRYPTION_KEY_V5=""
   
# Legacy fallback key (backward-compatible decryption only)
ENCRYPTION_KEY=""
CURRENT_KEY_VERSION=v1
ENCRYPTION_MIGRATION_MODE=false
LEGACY_FORMAT_DEADLINE=""
ROTATION_BATCH_SIZE=100

# ============================================
# GDPR Compliance
# ============================================
ODPC_EMAIL=dpo@odpc.go.ke
DPO_EMAIL=dpo@buildmarket.live
EXPORT_EXPIRY_HOURS=48
DELETION_GRACE_PERIOD_DAYS=30

# ============================================
# SMS Service [OPTIONAL]
# ============================================
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=""
AFRICASTALKING_SENDER_ID=BuildMarket

# ============================================
# Scheduler
# ============================================
EXPORT_CLEANUP_CRON=0 2 * * *
DATA_RETENTION_CRON=0 3 * * *
ANONYMIZATION_BATCH_CRON=0 4 * * *
ASSET_CLEANUP_CRON=0 5 * * *
ONBOARDING_UPLOAD_CLEANUP_CRON=0 3 * * *
CLEANUP_BATCH_SIZE=100
EXPORT_CLEANUP_BATCH_SIZE=100
EXPORT_CLEANUP_MAX_RETRIES=3
ANONYMIZATION_BATCH_SIZE=50
RETENTION_BATCH_SIZE=100

# ============================================
# Feature Flags
# ============================================
ENABLE_GDPR_FEATURES=true
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true
FEATURE_PORTAL_DASHBOARD_V2=true
FEATURE_PORTAL_LEADS_V2=true
FEATURE_PORTAL_FINANCE_V2=true
FEATURE_PORTAL_PROJECTS_V2=true
FEATURE_PORTAL_QUOTES_V2=true
FEATURE_PORTAL_STORES_V2=true
FEATURE_PORTAL_CALENDAR_V2=true
FEATURE_PORTAL_PORTFOLIO_V2=true

# ============================================
# Misc
# ============================================
DRAFT_STORAGE_KEY="professional-profile-draft"

# ============================================
# Development Only — NEVER enable in CI/production
# ============================================
NODE_ENV=development
BYPASS_AUTH=false
DEV_CLERK_ID=user_local_dev
DEV_DB_USER_ID=00000000-0000-0000-0000-000000000000
DEV_USER_EMAIL=developer@example.com
DEV_USER_ROLE=PROFESSIONAL
ANALYZE=false

# Next.js runtime marker — DO NOT SET in Vercel environment variables.
# This is injected by the framework and manual assignment breaks edge detection.
# NEXT_RUNTIME=

# ESP Worker Health Port
WORKER_HEALTH_PORT=8080

# Point to your local bare-metal Datadog Agent gRPC port or Datadog OTLP endpoint
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4317"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="https://otlp-intake.us5.datadoghq.com/v1/traces"
OTEL_EXPORTER_OTLP_HEADERS=""

# Service Identifier Metadata & Datadog APM
OTEL_SERVICE_NAME="buildmarket-client"
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=development,service.version=local"
DD_API_KEY=""
DD_SITE="us5.datadoghq.com"
DD_SERVICE="buildmarket-client"
DD_ENV="staging"
DD_VERSION="local"
DD_LOGS_ENABLED="false"

# ============================================
# Staging Environment HTTP Basic Auth & Anti-Crawling [OPTIONAL]
# Active when DD_ENV="staging" (or STAGING_AUTH_ENABLED="true") and password/secret set.
# ============================================
STAGING_AUTH_USER="buildmarket"
STAGING_AUTH_PASSWORD=""
STAGING_AUTH_SECRET=""
STAGING_AUTH_ENABLED="false"
