
# ============================================
# Build Market - Vercel Environment Template
# ============================================
# This file is a template for Vercel deployments.
# DO NOT store live secrets here. Configure real values in Vercel project settings.
#
# All URLs use the deployed Vercel domain: https://build-market-ebon.vercel.app
#
# [SECRET] = must be set in Vercel dashboard, never committed
#
# NEXT_RUNTIME is injected by Next.js. DO NOT set it manually in Vercel env vars.
#

NODE_ENV=production

# --- App URLs ---
NEXT_PUBLIC_APP_URL=https://build-market-ebon.vercel.app
NEXT_PUBLIC_API_URL=https://build-market-ebon.vercel.app/api
NEXT_PUBLIC_SEARCH_SERVICE_URL=https://build-market-ebon.vercel.app/search

# --- Clerk Auth (Required) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=[SECRET]
CLERK_SECRET_KEY=[SECRET]
CLERK_WEBHOOK_SECRET=[SECRET]
NEXT_PUBLIC_CLERK_FRONTEND_API="https://your-clerk-frontend-api.accounts.dev"
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- Google OAuth (Optional) ---
GOOGLE_CLIENT_ID=[SECRET]
GOOGLE_CLIENT_SECRET=[SECRET]

# --- Messaging/Analytics ---
NEXT_PUBLIC_MESSAGING_SERVICE_URL=https://build-market-ebon.vercel.app/messaging
NEXT_PUBLIC_POSTHOG_KEY=[SECRET]
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GEMINI_API_KEY=[SECRET]

# --- Email/SMTP ---
SMTP_HOST=[SECRET]
SMTP_PORT=587
SMTP_FROM=noreply@buildmarket.co.ke
SMTP_USER=[SECRET]
SMTP_PASSWORD=[SECRET]

# --- CORS/CSRF ---
CORS_ALLOWED_ORIGINS=https://build-market-ebon.vercel.app
CSRF_TRUSTED_ORIGINS=https://build-market-ebon.vercel.app

# --- Redis (Choose ONE option for Vercel) ---
# Option A: Upstash Redis (Recommended for Vercel)
UPSTASH_REDIS_REST_URL=[SECRET]
UPSTASH_REDIS_REST_TOKEN=[SECRET]
# Option B: REDIS_URL (single URL string)
REDIS_URL=[SECRET]
# Option C: Host/Port (legacy/manual)
REDIS_HOST=[SECRET]
REDIS_PORT=6379
REDIS_PASSWORD=[SECRET]
REDIS_DB=0
REDIS_ENABLED=true
REDIS_TLS=true
REDIS_KEY_PREFIX=
REDIS_MAX_RETRIES_PER_REQUEST=5
REDIS_CONNECT_TIMEOUT=10000
REDIS_REQUIRED_MAXMEMORY_POLICY=noeviction
REDIS_MAXMEMORY_POLICY_ENFORCEMENT=error

# --- Queue/Feature Flags ---
QUEUE_PROVIDER=REDIS
ENABLE_NOTIFICATION_SERVICE=true
ENABLE_GDPR_FEATURES=true
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true

# --- NATS Messaging ---
NATS_URL=[SECRET]
NATS_CLUSTER_ID=buildmarket-cluster
NATS_CLIENT_ID=client-app-prod
NATS_CLIENT_NAME=client-app

# --- S3/AWS ---
S3_DISABLED=false
AWS_REGION=af-south-1
S3_EXPORT_BUCKET=[SECRET]
EXPORTS_BUCKET_NAME=[SECRET]
EXPORT_LOCAL_DIR=./temp-exports

# --- Encryption ---
ENCRYPTION_KEY_V1=[SECRET]
ENCRYPTION_KEY_V2=[SECRET]
ENCRYPTION_KEY=[SECRET]
CURRENT_KEY_VERSION=v1
ENCRYPTION_MIGRATION_MODE=false
LEGACY_FORMAT_DEADLINE=

# --- GDPR/Compliance ---
ODPC_EMAIL=dpo@odpc.go.ke
DPO_EMAIL=dpo@buildmarket.co.ke
EXPORT_EXPIRY_HOURS=48
DELETION_GRACE_PERIOD_DAYS=30

# --- SMS ---
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=[SECRET]
AFRICASTALKING_SENDER_ID=BuildMarket

# --- Scheduler ---
EXPORT_CLEANUP_CRON=0 2 * * *
DATA_RETENTION_CRON=0 3 * * *
ANONYMIZATION_BATCH_CRON=0 4 * * *
ASSET_CLEANUP_CRON=0 5 * * *
ONBOARDING_UPLOAD_CLEANUP_CRON=0 3 * * *
CLEANUP_BATCH_SIZE=100
ANONYMIZATION_BATCH_SIZE=50
RETENTION_BATCH_SIZE=100

# --- Misc ---
DRAFT_STORAGE_KEY=professional-profile-draft

# --- Next.js Runtime Marker ---
# NEXT_RUNTIME is injected by Next.js. DO NOT set manually in Vercel.
