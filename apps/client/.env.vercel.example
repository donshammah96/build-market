# ============================================
# Build Market - Vercel Environment Template
# ============================================
# Placeholder-only file. Do not store live secrets here.
# Configure real values in Vercel project environment settings.

NODE_ENV=production

NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_API_URL=https://your-domain.example/api
NEXT_PUBLIC_SEARCH_SERVICE_URL=https://search.your-domain.example

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_publishable_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

GOOGLE_CLIENT_ID="your_google_client_id"
REACT_APP_AUTH0_DOMAIN="your_auth0_domain"
REACT_APP_AUTH0_CLIENT_ID="your_auth0_client_id"

ENABLE_NOTIFICATION_SERVICE=true
QUEUE_PROVIDER="REDIS"

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@buildmarket.co.ke

REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_DB=0
REDIS_ENABLED=true
REDIS_KEY_PREFIX=
REDIS_TLS=true
REDIS_MAX_RETRIES_PER_REQUEST=5
REDIS_CONNECT_TIMEOUT=10000

NATS_URL="nats://your-nats-host:4222"
NATS_CLUSTER_ID="buildmarket-cluster"
NATS_CLIENT_ID="client-app-prod"
NATS_CLIENT_NAME="client-app"

S3_DISABLED=false
AWS_REGION=af-south-1
S3_EXPORT_BUCKET=your-exports-bucket
EXPORTS_BUCKET_NAME=your-gdpr-exports-bucket
EXPORT_LOCAL_DIR=./temp-exports

CURRENT_KEY_VERSION=v1
ENCRYPTION_MIGRATION_MODE=false
LEGACY_FORMAT_DEADLINE=

ODPC_EMAIL=dpo@odpc.go.ke
DPO_EMAIL=dpo@buildmarket.co.ke
EXPORT_EXPIRY_HOURS=48
DELETION_GRACE_PERIOD_DAYS=30

SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=BuildMarket

EXPORT_CLEANUP_CRON=0 2 * * *
DATA_RETENTION_CRON=0 3 * * *
ANONYMIZATION_BATCH_CRON=0 4 * * *
ASSET_CLEANUP_CRON=0 5 * * *
ONBOARDING_UPLOAD_CLEANUP_CRON=0 3 * * *
CLEANUP_BATCH_SIZE=100
ANONYMIZATION_BATCH_SIZE=50
RETENTION_BATCH_SIZE=100

ENABLE_GDPR_FEATURES=true
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true

DRAFT_STORAGE_KEY="professional-profile-draft"
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
