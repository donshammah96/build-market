# ============================================
# Build Market — Vercel Production Environment Template
# ============================================
# DO NOT store real secrets in this file.
# This is a TEMPLATE showing which variables must be configured
# in Vercel Project Settings → Environment Variables.
#
# Your production domain: https://build-market-ebon.vercel.app
#
# HOW TO USE:
#   1. Go to https://vercel.com/dashboard → your project → Settings → Environment Variables
#   2. Add every variable listed below as "Production" (and optionally "Preview")
#   3. Secret variables (marked with [SECRET]) should ONLY live in Vercel's UI — never in files
#   4. After adding all variables, trigger a new deployment
#
# ENVIRONMENT SCOPES:
#   Production  — build-market-ebon.vercel.app
#   Preview     — PR preview deployments (use staging/test values)
#   Development — (use .env.local locally, not this file)
# ============================================

# ============================================
# RUNTIME CONTEXT — DO NOT SET MANUALLY IN VERCEL
# These are injected automatically by Next.js/Vercel.
# Setting them explicitly can break runtime detection.
# ============================================
# NODE_ENV=production          ← Vercel sets this automatically
# NEXT_RUNTIME=nodejs          ← Injected by Next.js, do not override
# NEXT_PHASE=                  ← Injected by Next.js build system

# ============================================
# Application URLs [REQUIRED — set before first deploy]
# ============================================
NEXT_PUBLIC_APP_URL=https://build-market-ebon.vercel.app
NEXT_PUBLIC_API_URL=https://build-market-ebon.vercel.app/api
NEXT_PUBLIC_SEARCH_SERVICE_URL=https://build-market-ebon.vercel.app
APP_URL=https://build-market-ebon.vercel.app

# ============================================
# Clerk Authentication [REQUIRED] [SECRET for secret key]
# Get production keys from: https://dashboard.clerk.com
# Use pk_live_* / sk_live_* for production.
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_live_publishable_key

# [SECRET] — add to Vercel UI only, never in this file
# CLERK_SECRET_KEY=sk_live_your_live_secret_key

# [SECRET] — add to Vercel UI only
# CLERK_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# Clerk redirect URLs — use relative paths for portability across preview deployments
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Safety net only. Auth entry points explicitly use forceRedirectUrl, but keep
# Clerk env fallbacks aligned to the auth callback if they are ever consulted.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth-callback
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth-callback
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_ADMIN_APP_URL=https://build-market-ebon.vercel.app/admin

# Clerk Frontend API — only set this if using a custom Clerk domain
# Leave blank to let Clerk SDK auto-discover it from the publishable key.
# NEXT_PUBLIC_CLERK_FRONTEND_API=https://your-custom-clerk-domain.com

# ============================================
# Auth [REQUIRED] [SECRET]
# Generate with: openssl rand -base64 32
# ============================================
# [SECRET] — add to Vercel UI only
# AUTH_SECRET=your_production_auth_secret_base64

# ============================================
# Database [REQUIRED] [SECRET]
# Supabase: use the session-mode pooler URL for runtime.
# Get both strings from: Supabase Dashboard → Project Settings → Database → Connection String
# ============================================

# Runtime — Supabase Supavisor session-mode pooler (safe for Vercel serverless)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
# [SECRET] — add to Vercel UI only
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Migrations only — direct connection (requires Supabase IPv4 add-on on free tier)
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Only needed for: prisma migrate deploy (run during CI or Vercel build step)
# [SECRET] — add to Vercel UI only
# DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase project metadata (for SDK / Realtime — not required for Prisma-only use)
SUPABASE_URL=https://ewbnznoprzlqtcoxvjai.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# [SECRET] — server-side only, NEVER prefix with NEXT_PUBLIC_, bypasses RLS
# SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Encryption [REQUIRED] [SECRET]
# Generate with: openssl rand -hex 32
# NEVER rotate without updating CURRENT_KEY_VERSION and keeping old keys.
# ============================================
# [SECRET] — add to Vercel UI only
# ENCRYPTION_KEY_V1=your_64_hex_char_key
CURRENT_KEY_VERSION=v1
ENCRYPTION_MIGRATION_MODE=false

# ============================================
# Internal API Secret [REQUIRED] [SECRET]
# Used for internal service-to-service calls.
# Generate with: openssl rand -base64 32
# ============================================
# [SECRET] — add to Vercel UI only
# INTERNAL_API_SECRET=your_production_internal_secret

# ============================================
# Redis / Upstash [REQUIRED FOR PRODUCTION]
# Primary transport: Upstash REST over HTTPS (serverless-safe, no TCP connections).
# BullMQ workers additionally need REDIS_URL (Upstash TCP endpoint).
# Create a database at: https://upstash.com
# ============================================

# PRIMARY — Upstash REST credentials (required for rate limiting + caching)
# [SECRET] — add to Vercel UI only
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# BullMQ TCP endpoint — required for services running queue workers
# Format: rediss://:TOKEN@<host>.upstash.io:6379
# Token value is the same as UPSTASH_REDIS_REST_TOKEN
# [SECRET] — add to Vercel UI only
# REDIS_URL=rediss://:TOKEN@<host>.upstash.io:6379

RATE_LIMIT_BACKEND=auto
DISABLE_BACKGROUND_JOBS=false

# ============================================
# CORS / CSRF — trusted origins
# Add your production domain AND any preview domains you want to allow.
# Comma-separated list of allowed origins.
# ============================================
CORS_ALLOWED_ORIGINS=https://build-market-ebon.vercel.app
CSRF_TRUSTED_ORIGINS=https://build-market-ebon.vercel.app

# ============================================
# Email Service [REQUIRED for transactional emails]
# Option A — Resend (recommended): https://resend.com
# Option B — SMTP fallback
# ============================================
# [SECRET] — add to Vercel UI only
# RESEND_API_KEY=re_your_resend_api_key

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_FROM=noreply@buildmarket.live

# ============================================
# Cloudflare R2 (S3-compatible) [REQUIRED for production uploads/exports]
# Canonical variables are R2_*.
# AWS_* and S3_* aliases are temporary and will be removed after one release.
# ============================================
S3_DISABLED=false
STORAGE_PROVIDER=s3
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ASSET_BUCKET=buildmarket-assets
R2_PRIVATE_BUCKET=buildmarket-private-assets
R2_EXPORT_BUCKET=buildmarket-exports
R2_PUBLIC_BASE_URL=https://cdn.buildmarket.app
EXPORT_LOCAL_DIR=./temp-exports

# [SECRET] - add to Vercel UI only
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Legacy aliases (temporary fallback during migration)
AWS_REGION=af-south-1
# AWS_ACCESS_KEY_ID=your_legacy_access_key_id
# AWS_SECRET_ACCESS_KEY=your_legacy_secret_access_key
S3_ASSET_BUCKET=buildmarket-assets
S3_PRIVATE_BUCKET=buildmarket-private-assets
S3_EXPORT_BUCKET=buildmarket-exports
EXPORTS_BUCKET_NAME=buildmarket-gdpr-exports
CDN_URL=https://cdn.buildmarket.live
S3_EU_URL=https://<account_id>.eu.r2.cloudflarestorage.com

# Upload processing: must be false in production (worker queue enforced)
UPLOAD_PROCESS_INLINE=false
UPLOAD_STATUS_TTL_SECONDS=1800

# ============================================
# Webhook Replay Protection
# ============================================
CLERK_WEBHOOK_REPLAY_WINDOW_SECONDS=300
CLERK_WEBHOOK_PROCESSING_TTL_SECONDS=120
CLERK_WEBHOOK_PROCESSED_TTL_SECONDS=86400

# ============================================
# NATS Messaging [OPTIONAL — for event-driven features]
# ============================================
# NATS_URL=nats://your-nats-host:4222
NATS_CLIENT_NAME=client-app-prod
# [SECRET] — add to Vercel UI only if authentication is required
# NATS_TOKEN=your_nats_auth_token

# ============================================
# OAuth Providers [OPTIONAL]
# ============================================
# Google OAuth: https://console.developers.google.com
# GOOGLE_CLIENT_ID=your_google_client_id
# [SECRET]
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your_github_client_id
# [SECRET]
# GITHUB_CLIENT_SECRET=your_github_client_secret

# ============================================
# Analytics [OPTIONAL]
# ============================================
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key

# ============================================
# GDPR Compliance
# ============================================
ODPC_EMAIL=dpo@odpc.go.ke
DPO_EMAIL=dpo@buildmarket.live
EXPORT_EXPIRY_HOURS=48
DELETION_GRACE_PERIOD_DAYS=30

# ============================================
# Feature Flags
# ============================================
ENABLE_NOTIFICATION_SERVICE=true
ENABLE_GDPR_FEATURES=true
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true

# ============================================
# Scheduler / Maintenance Jobs
# ============================================
EXPORT_CLEANUP_CRON=0 2 * * *
DATA_RETENTION_CRON=0 3 * * *
ANONYMIZATION_BATCH_CRON=0 4 * * *
ASSET_CLEANUP_CRON=0 5 * * *
ONBOARDING_UPLOAD_CLEANUP_CRON=0 3 * * *
CLEANUP_BATCH_SIZE=100
EXPORT_CLEANUP_BATCH_SIZE=100
EXPORT_CLEANUP_MAX_RETRIES=3
ANONYMIZATION_BATCH_SIZE=50
RETENTION_BATCH_SIZE=100

# ============================================
# Misc
# ============================================
QUEUE_PROVIDER=REDIS
DRAFT_STORAGE_KEY=professional-profile-draft
HCAPTCHA_SECRET_KEY=
SMS_PROVIDER=africastalking
AFRICASTALKING_SENDER_ID=BuildMarket

# ============================================
# Security — NEVER enable these in production
# ============================================
BYPASS_AUTH=false

# ESP Worker Health Port
WORKER_HEALTH_PORT=8080
