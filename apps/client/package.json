{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3500",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --testPathPattern=unit",
    "test:integration": "vitest --testPathPattern=integration",
    "test:e2e:vitest": "vitest --testPathPattern=e2e",
    "migrate:gdpr": "tsx scripts/migrate-gdpr-imports.ts",
    "migrate:gdpr:dry": "tsx scripts/migrate-gdpr-imports.ts --dry-run",
    "rotate:keys": "tsx scripts/rotate-encryption-keys.ts",
    "rotate:keys:dry": "tsx scripts/rotate-encryption-keys.ts --dry-run",
    "check-env-contract": "node scripts/check-env-contract.mjs",
    "check-log-safety": "node scripts/check-log-safety.mjs",
    "check-no-direct-env": "node scripts/check-no-direct-env.mjs",
    "check-browser-persistence": "node scripts/check-browser-persistence.mjs",
    "check-cors-policy": "node scripts/check-cors-policy.mjs",
    "report:projects-mutation-health": "node scripts/summarize-project-mutation-health.mjs",
    "check-security-lint": "node scripts/check-security-lint.mjs",
    "build:high-risk-registry": "node scripts/build-high-risk-registry.mjs",
    "report-security-drift": "pnpm run build:high-risk-registry && node scripts/report-security-drift.mjs",
    "report-security-drift:strict": "pnpm run build:high-risk-registry && node scripts/report-security-drift.mjs --fail-on-any",
    "check-security-drift": "pnpm run check-log-safety && pnpm run check-no-direct-env && pnpm run check-browser-persistence && pnpm run check-cors-policy && pnpm run check-security-lint",
    "optimize:public-images": "node scripts/optimize-public-images.mjs",
    "check:worker-asset-budget:public": "node scripts/check-worker-asset-budget.mjs public",
    "check:worker-asset-budget:open-next": "node scripts/check-worker-asset-budget.mjs .open-next/assets",
    "test:add-009-policy": "vitest run __tests__/actions/add-009-server-action-validation-policy.test.ts",
    "test:tier3-transition-policy": "vitest run __tests__/actions/tier3-high-value-guard-policy.test.ts __tests__/actions/onboarding-tier3-guards.test.ts",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headed": "cypress run --headed",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:component": "cypress run --component",
    "test:e2e": "start-server-and-test dev http://localhost:3500 cy:run",
    "test:e2e:open": "start-server-and-test dev http://localhost:3500 cy:open",
    "gen-keys": "tsx generate-keys.ts",
    "build": "next build",
    "build:cloudflare-worker": "pnpm run check:worker-asset-budget:public && opennextjs-cloudflare build --config wrangler.toml --skipWranglerConfigCheck && pnpm run check:worker-asset-budget:open-next",
    "start": "next start",
    "lint": "eslint . --cache",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1033.0",
