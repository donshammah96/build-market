# ==============================================================================
# apps/verification-ops — Environment Configuration Template (.env.example)
# ==============================================================================
# Single source of truth for required and optional environment variables.
# DO NOT place real secrets in this file.
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION (Shared instance with apps/client & apps/admin)
# ------------------------------------------------------------------------------
# Obtain publishable & secret keys from Clerk Dashboard (use TEST instance locally).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_do_not_use_in_prod
CLERK_SECRET_KEY=sk_test_placeholder_do_not_use_in_prod
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Satellite configuration (mirrors apps/admin) ----------------------------
# This app is a Clerk satellite of apps/client (buildmarket.app): the primary
# app owns the canonical sign-in session; this app only consumes it.
#
# Leave NEXT_PUBLIC_CLERK_IS_SATELLITE unset/false for local dev if you'd
# rather run this app standalone against a local Clerk test instance without
# a running apps/client — that path still works (see middleware.ts's
# non-satellite fallback). Set it to true to match staging/production.
NEXT_PUBLIC_CLERK_IS_SATELLITE=false

# Bare host only (no scheme) — Clerk normalizes this internally, but
# layout.tsx/middleware.ts also strip an accidental scheme defensively.
NEXT_PUBLIC_CLERK_DOMAIN=verification.buildmarket.app

# MUST be an absolute URL pointing at the PRIMARY app's sign-in route
# (apps/client, not this app). A relative path here causes an infinite
# redirect loop the moment NEXT_PUBLIC_CLERK_IS_SATELLITE=true — see
# middleware.ts's header comment for the full explanation. Only takes
# effect when NEXT_PUBLIC_CLERK_IS_SATELLITE=true.
NEXT_PUBLIC_CLERK_PRIMARY_SIGN_IN_URL=https://accounts.buildmarket.app/sign-in

# ------------------------------------------------------------------------------
# 2. DATABASE CONNECTION (@build/db / Prisma)
# ------------------------------------------------------------------------------
# Direct or pooler PostgreSQL connection URL (never use production DB locally).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buildmarket_dev?schema=public

# ------------------------------------------------------------------------------
# 3. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL for this Verification Operations application instance.
NEXT_PUBLIC_VERIFICATION_OPS_URL=http://localhost:3501

# ------------------------------------------------------------------------------
# 4. OPENTELEMETRY & DATADOG APM CONFIGURATION
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp-intake.us5.datadoghq.com/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
DD_API_KEY=
DD_SITE=us5.datadoghq.com
DD_SERVICE=buildmarket-verification-ops
DD_ENV=staging
DD_VERSION=local
DD_LOGS_ENABLED=false

