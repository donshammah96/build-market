{
  "extends": "@build/typescript-config/nextjs.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "composite": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/lib/*": ["./lib/*"],
      "@/ui/*": ["./components/*"],
      "@/routes": ["./lib/routes/index"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "docs", ".next"],
  "references": [
    { "path": "../../packages/resilience" },
    { "path": "../../packages/db" },
    { "path": "../../packages/types" },
    { "path": "../../packages/enums" },
    { "path": "../../packages/ui" },
    { "path": "../../packages/verification-domain" },
    { "path": "../../packages/security-clerk" },
    { "path": "../../packages/env-validation" },
    { "path": "../../packages/clerk-test-harness" },
    { "path": "../../packages/telemetry" }
  ]
}
