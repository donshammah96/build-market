{
  "name": "build-market",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-typescript.mjs && node scripts/patch-opennext.mjs",
    "clean": "turbo run clean && rimraf node_modules",
    "clean:cache": "turbo daemon clean && rimraf .turbo",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\" --log-level warn",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\" --log-level warn",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run check-types",
    "test": "turbo run test",
    "validate": "pnpm run check:workspace-versions && pnpm run deps:audit && pnpm run format && pnpm run format:check && pnpm run mpesa:check-security-boundary && pnpm run client:report-security-drift:strict && pnpm run admin:report-security-drift:strict && pnpm run verification-ops:report-security-drift:strict && pnpm run lint && pnpm run check-types && pnpm run test",
    "ci:local": "pnpm run check:workspace-versions && pnpm run docs:check-launch-governance && pnpm run deps:audit && pnpm run format:check && pnpm run lint && pnpm run mpesa:check-security-boundary && pnpm run client:check-env-contract && pnpm run client:check-security-drift && pnpm run client:report-security-drift:strict && pnpm run admin:check-env-contract && pnpm run admin:check-security-drift && pnpm run admin:report-security-drift:strict && pnpm run verification-ops:check-env-contract && pnpm run verification-ops:check-security-drift && pnpm run verification-ops:report-security-drift:strict && pnpm run verification-ops:check-all && pnpm run check-types && pnpm run admin:check-governance && pnpm run admin:check-all && pnpm run test",
    "ci:local:full": "pnpm install --frozen-lockfile && pnpm run ci:local",
    "release:verify": "pnpm run ci:local && pnpm client:test __tests__/lib/capabilities/registry.test.ts __tests__/lib/capabilities/boundary.test.ts __tests__/middleware/middleware.test.ts && node --test scripts/__tests__/generate-release-evidence.test.mjs",
    "release:evidence:generate": "node scripts/generate-release-evidence.mjs",
    "check:catalog": "node ./scripts/check-catalog-consistency.mjs",
    "check:workspace-versions": "node ./scripts/check-package-manager-consistency.mjs && node ./scripts/check-catalog-consistency.mjs",
    "docs:check-launch-governance": "node ./scripts/check-launch-documentation-governance.mjs",
    "check:instructions": "pnpm run sync:instructions-aligned-date && node ./scripts/check-instructions-frontmatter.mjs",
    "sync:instructions-aligned-date": "node ./scripts/sync-instruction-alignment-date.mjs",
    "deps:audit": "pnpm audit --prod",
    "deps:outdated": "pnpm outdated -r",
    "db:migrate:deploy": "pnpm -C packages/db exec prisma migrate deploy",
    "db:generate": "pnpm -C packages/db exec prisma generate",
    "db:seed": "pnpm -C packages/db exec prisma db seed",
    "redis:audit": "node ./scripts/redis-path-audit.mjs",
    "redis:healthcheck": "pnpm -C packages/redis run healthcheck",
    "redis:enforce-policy": "pnpm -C packages/redis run enforce-maxmemory-policy",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build:workers": "docker build -f apps/workers/Dockerfile -t build-market-workers .",
    "build:client": "turbo run build --filter=client",
    "build:admin": "turbo run build --filter=admin",
    "build:verification-ops": "turbo run build --filter=verification-ops",
    "build:workers": "turbo run build --filter=workers",
    "build:packages": "pnpm run db:generate && turbo run build --filter=./packages/*",
    "dev:client": "turbo run dev --filter=client",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:verification-ops": "turbo run dev --filter=verification-ops",
    "dev:workers": "turbo run dev --filter=workers",
    "dev:frontend": "turbo run dev --filter=client --filter=admin",
    "client:check-types": "pnpm -C apps/client exec tsc --noEmit",
    "client:build:cloudflare-worker": "pnpm -C apps/client run build:cloudflare-worker",
    "client:deploy:cloudflare-worker": "pnpm -C apps/client exec wrangler deploy --config wrangler.toml",
    "client:check-env-contract": "pnpm -C apps/client run check-env-contract",
    "client:check-security-drift": "pnpm -C apps/client run check-security-drift",
    "client:report-security-drift": "pnpm -C apps/client run report-security-drift",
    "client:report-security-drift:strict": "pnpm -C apps/client run report-security-drift:strict",
    "client:test:add-009-policy": "pnpm -C apps/client run test:add-009-policy",
    "client:test:tier3-transition-policy": "pnpm -C apps/client run test:tier3-transition-policy",
    "client:test": "pnpm -C apps/client run test",
    "client:test:all": "pnpm -C apps/client exec vitest --run",
    "mpesa:check-security-boundary": "node scripts/check-mpesa-security-boundary.mjs",
    "admin:check-types": "pnpm -C apps/admin run check-types",
    "admin:lint": "pnpm -C apps/admin run lint",
    "admin:test": "pnpm -C apps/admin run test",
    "admin:test:all": "pnpm -C apps/admin run test:all",
    "admin:check-env-contract": "pnpm -C apps/admin run check-env-contract",
    "admin:check-security-drift": "pnpm -C apps/admin run check-security-drift",
    "admin:report-security-drift": "pnpm -C apps/admin run report-security-drift",
    "admin:report-security-drift:strict": "pnpm -C apps/admin run report-security-drift:strict",
    "admin:check-governance": "pnpm -C apps/admin run check-governance",
    "admin:check-all": "pnpm -C apps/admin run check-all",
    "verification-ops:check-types": "pnpm -C apps/verification-ops run check-types",
    "verification-ops:lint": "pnpm -C apps/verification-ops run lint",
    "verification-ops:test": "pnpm -C apps/verification-ops run test",
    "verification-ops:check-env-contract": "pnpm -C apps/verification-ops run check-env-contract",
    "verification-ops:check-security-drift": "pnpm -C apps/verification-ops run check-security-drift",
    "verification-ops:report-security-drift": "pnpm -C apps/verification-ops run report-security-drift",
    "verification-ops:report-security-drift:strict": "pnpm -C apps/verification-ops run report-security-drift:strict",
    "verification-ops:check-all": "pnpm -C apps/verification-ops run check-all",
    "queue-server:check-types": "pnpm -C packages/queue-server run check-types",
    "workers:check-types": "pnpm -C apps/workers run check-types"
  },
  "devDependencies": {
    "@typescript/typescript6": "catalog:",
    "next": "catalog:",
    "prettier": "catalog:",
    "rimraf": "^6.1.3",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.1.2 <12.0.0"
  }
}
