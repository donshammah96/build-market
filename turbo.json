{
  "ui": "tui",
  "globalDependencies": [".env*"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "POSTGRES_URL",
        "KAFKA_BROKERS",
        "MESSAGING_SERVICE_URL",
        "INTERNAL_API_SECRET",
        "CLIENT_APP_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",
        "AZURE_AD_CLIENT_ID",
        "AZURE_AD_CLIENT_SECRET",
        "AZURE_AD_TENANT_ID",
        "CLERK_WEBHOOK_SECRET",
        "CLERK_SECRET_KEY",
        "HCAPTCHA_SECRET_KEY",
        "RESEND_API_KEY",
        "DEV_ADMIN_BYPASS"
      ]
    },
    "admin#build": {
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "client#build": {
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "project-service#build": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true,
      "env": [
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "CLERK_WEBHOOK_SECRET",
        "DATABASE_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "ENCRYPTION_KEY_V1",
        "NATS_URL",
        "NATS_CLIENT_NAME",
        "NATS_MAX_RECONNECT_ATTEMPTS",
        "NATS_RECONNECT_TIME_WAIT",
        "NATS_TIMEOUT",
        "NATS_TOKEN",
        "NATS_USER",
        "NATS_PASS"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "env": [
        "DATABASE_URL",
        "POSTGRES_URL",
        "INTERNAL_API_SECRET",
        "CLERK_SECRET_KEY",
        "CLERK_WEBHOOK_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN"
      ]
    }
  },
  "remoteCache": {
    "enabled": true
  }
}
