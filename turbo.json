{
  "ui": "tui",
  "globalDependencies": [".env*"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SEARCH_SERVICE_URL",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_FRONTEND_API",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
    "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL",
    "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL",
    "GOOGLE_CLIENT_ID",
    "REACT_APP_AUTH0_DOMAIN",
    "REACT_APP_AUTH0_CLIENT_ID",
    "ENABLE_NOTIFICATION_SERVICE",
    "QUEUE_PROVIDER",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_FROM",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_USERNAME",
    "REDIS_DB",
    "REDIS_ENABLED",
    "REDIS_KEY_PREFIX",
    "REDIS_TLS",
    "REDIS_MAX_RETRIES_PER_REQUEST",
    "REDIS_CONNECT_TIMEOUT",
    "REDIS_REQUIRED_MAXMEMORY_POLICY",
    "REDIS_MAXMEMORY_POLICY_ENFORCEMENT",
    "NATS_URL",
    "NATS_CLUSTER_ID",
    "NATS_CLIENT_ID",
    "NATS_CLIENT_NAME",
    "S3_DISABLED",
    "AWS_REGION",
    "S3_EXPORT_BUCKET",
    "EXPORTS_BUCKET_NAME",
    "EXPORT_LOCAL_DIR",
    "CURRENT_KEY_VERSION",
    "ENCRYPTION_MIGRATION_MODE",
    "LEGACY_FORMAT_DEADLINE",
    "ODPC_EMAIL",
    "DPO_EMAIL",
    "EXPORT_EXPIRY_HOURS",
    "DELETION_GRACE_PERIOD_DAYS",
    "SMS_PROVIDER",
    "AFRICASTALKING_USERNAME",
    "AFRICASTALKING_SENDER_ID",
    "EXPORT_CLEANUP_CRON",
    "DATA_RETENTION_CRON",
    "ANONYMIZATION_BATCH_CRON",
    "ASSET_CLEANUP_CRON",
    "ONBOARDING_UPLOAD_CLEANUP_CRON",
    "CLEANUP_BATCH_SIZE",
    "ANONYMIZATION_BATCH_SIZE",
    "RETENTION_BATCH_SIZE",
    "ENABLE_GDPR_FEATURES",
    "ENABLE_ENCRYPTION",
    "ENABLE_AUDIT_LOGGING",
    "DRAFT_STORAGE_KEY",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST"
  ],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "POSTGRES_URL",
        "KAFKA_BROKERS",
        "MESSAGING_SERVICE_URL",
        "INTERNAL_API_SECRET",
        "CLIENT_APP_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "REDIS_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "FACEBOOK_CLIENT_ID",
        "FACEBOOK_CLIENT_SECRET",
        "AZURE_AD_CLIENT_ID",
        "AZURE_AD_CLIENT_SECRET",
        "AZURE_AD_TENANT_ID",
        "CLERK_WEBHOOK_SECRET",
        "CLERK_SECRET_KEY",
        "HCAPTCHA_SECRET_KEY",
        "RESEND_API_KEY",
        "DEV_ADMIN_BYPASS"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true,
      "env": [
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "CLERK_WEBHOOK_SECRET",
        "DATABASE_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "ENCRYPTION_KEY_V1",
        "NATS_URL",
        "NATS_CLIENT_NAME",
        "NATS_MAX_RECONNECT_ATTEMPTS",
        "NATS_RECONNECT_TIME_WAIT",
        "NATS_TIMEOUT",
        "NATS_TOKEN",
        "NATS_USER",
        "NATS_PASS"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "env": [
        "DATABASE_URL",
        "POSTGRES_URL",
        "INTERNAL_API_SECRET",
        "CLERK_SECRET_KEY",
        "CLERK_WEBHOOK_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN"
      ]
    }
  },
  "remoteCache": {
    "enabled": true
  }
}
