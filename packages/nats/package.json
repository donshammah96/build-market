{
  "name": "@build/nats",
  "version": "1.0.0",
  "description": "NATS JetStream messaging package for Build Market",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); try { require('fs').unlinkSync('tsconfig.tsbuildinfo'); } catch(e) {}\"",
    "prebuild": "pnpm run clean",
    "lint": "eslint src/ --cache",
    "check-types": "tsc --noEmit",
    "build": "tsc",
    "prepack": "pnpm run build",
    "test": "echo \"No unit tests configured\" && exit 0",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "nats": "catalog:"
  },
  "devDependencies": {
    "@build/eslint-config": "workspace:*",
    "@build/typescript-config": "workspace:*",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}