{
  "name": "@build/redis",
  "version": "1.0.0",
  "description": "Redis client and caching utilities for the monorepo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tcp": {
      "types": "./dist/tcp.d.ts",
      "import": "./dist/tcp.js",
      "default": "./dist/tcp.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); try { require('fs').unlinkSync('tsconfig.tsbuildinfo'); } catch(e) {}\"",
    "prebuild": "pnpm run clean",
    "build": "tsc --build",
    "prepack": "pnpm run build",
    "lint": "eslint . --max-warnings 0",
    "healthcheck": "node --env-file=../.env --import tsx ./src/healthcheck.ts",
    "enforce-maxmemory-policy": "node --env-file=../.env --import tsx ./src/enforce-maxmemory-policy.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run --exclude '**/dist/**' --passWithNoTests"
  },
  "dependencies": {
    "@upstash/ratelimit": "catalog:",
    "@upstash/redis": "catalog:",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "@build/eslint-config": "workspace:*",
    "@build/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}