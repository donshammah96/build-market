{
  "extends": "@build/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": true,
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declarationMap": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
