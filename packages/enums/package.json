{
  "name": "@build/enums",
  "version": "0.0.1",
  "description": "Shared enum constants for the build-market monorepo. Zero runtime dependencies — safe for both browser and server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "echo \"No lint configured\" && exit 0",
    "check-types": "tsc --noEmit",
    "build": "tsc",
    "test": "echo \"No tests configured\" && exit 0",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@build/typescript-config": "workspace:*",
    "@types/node": "^24.8.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "require": "./dist/index.js"
    }
  }
}
