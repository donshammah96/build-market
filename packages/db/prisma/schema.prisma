enum FailedNotificationStatus {
  PENDING
  COMPLETED
  DEAD_LETTER
}

enum NewsletterSubscriberStatus {
  PENDING_CONFIRMATION // signed up, confirmation email sent, not yet clicked
  SUBSCRIBED // confirmed, active
  UNSUBSCRIBED // user-initiated unsubscribe
  BOUNCED // ESP reported a hard bounce — never re-add without re-confirmation
  COMPLAINED // ESP reported a spam complaint — permanently suppressed
}

enum NewsletterEspSyncStatus {
  PENDING // not yet synced to the ESP
  SYNCED // successfully synced
  FAILED // sync attempt failed, will retry (see espNextRetryAt)
  DEAD_LETTER // exhausted retries — needs manual/ops follow-up
}

model NewsletterSubscriber {
  id    String @id @default(uuid())
  email String @unique @db.Citext

  // Best-effort link only — subscribing does not require an account and
  // must keep working if this is null.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status NewsletterSubscriberStatus @default(PENDING_CONFIRMATION)
  source String                     @default("footer") // "footer", "checkout", "professional_onboarding", ...

  // Consent audit trail (GDPR / Kenya DPA / CAN-SPAM)
  consentIpAddress String?
  consentUserAgent String? @db.Text

  // Double opt-in confirmation. Store a hash, never the raw token — same
  // reasoning as password reset tokens.
  confirmationTokenHash      String?   @unique
  confirmationTokenExpiresAt DateTime?
  confirmedAt                DateTime?
  lastConfirmationSentAt     DateTime?
  confirmationEmailStatus    String?   @default("PENDING") // "PENDING" | "SENT" | "FAILED"
  confirmationEmailLastError String?   @db.Text

  // Unsubscribe
  unsubscribeTokenHash String?   @unique
  unsubscribedAt       DateTime?
  unsubscribeReason    String?

  // ESP sync state — mirrors FailedNotification's retry-tracking pattern.
  espProvider      String? // "resend" | "mailchimp" | "stub"
  espContactId     String? // provider's contact ID once synced
  espSyncStatus    NewsletterEspSyncStatus @default(PENDING)
  espSyncAttempts  Int                     @default(0)
  espLastSyncError String?                 @db.Text
  espLastSyncAt    DateTime?
  espNextRetryAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([espSyncStatus, espNextRetryAt])
  @@index([userId])
  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model UploadScanEvent {
  id            String   @id @default(uuid())
  scanRequestId String   @unique
  uploadId      String
  status        String   // "CLEAN" | "INFECTED" | "ERROR"
  virusName     String?
  engineVersion String
  createdAt     DateTime @default(now())

  @@index([uploadId])
  @@index([status])
  @@index([createdAt])
  @@map("upload_scan_events")
}

// ========================================================
// 20. REGULATOR VERIFICATION (PHASE 9 - PROFESSIONAL ONBOARDING)
// ========================================================
// Durable, queryable record of every regulator verification attempt made by
// RegulatorVerificationGateway. This is the system of record for evidence,
// confidence scoring, manual-fallback routing, and dead-letter handling -
// the license-verification BullMQ queue and manual operator workflow both
// read/write through this model rather than trusting worker logs alone.

enum RegulatorVerificationCaseStatus {
  QUEUED // enqueued, not yet picked up by a worker
  PROCESSING // a worker has claimed this attempt (msg.working() equivalent)
  AUTO_VERIFIED
  AUTO_REJECTED
  NEEDS_MANUAL_REVIEW
  REGULATOR_UNAVAILABLE
  LOW_CONFIDENCE
  MANUALLY_VERIFIED // operator decision recorded via RegulatorVerificationDecision
  MANUALLY_REJECTED
  DEAD_LETTER // attempt budget exhausted, requires manual intervention to requeue
  EXPIRED
  APPROVED
  REJECTED
  PENDING
}

enum RegulatorVerificationDecisionOutcome {
  APPROVE
  REJECT
  REQUEST_MORE_INFO
}

model RegulatorVerificationCase {
  id             String               @id @default(uuid())
  professionalId String
  licenseId      String?
  license        ProfessionalLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  authority     LicenseAuthority
  licenseNumber String

  // Dedupe key mirrors buildRegulatorVerificationJobId() in gateway.ts so the
  // BullMQ jobId and this row's uniqueness constraint can never diverge.
  dedupeKey String @unique

  status RegulatorVerificationCaseStatus @default(QUEUED)

  // Queue/backoff bookkeeping (mirrors AuthOutboxEvent conventions)
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  nextAttemptAt DateTime @default(now())
  deadLetteredAt DateTime?
  deadLetterReason String?

  // Latest RegulatorVerificationResult snapshot
  confidence                 Float?
  confidenceReasons          Json?   @db.JsonB // string[]
  confidenceAlgorithmVersion String?
  confidenceBreakdown        Json?   @db.JsonB
  evidence                   Json?   @db.JsonB // RegulatorEvidenceSnapshot
  retryable                  Boolean @default(false)
  retryAfterSeconds          Int?
  manualFallbackReason       String?

  correlationId String?
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?

  decisions     RegulatorVerificationDecision[]
  evidenceViews RegulatorVerificationEvidenceView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt]) // worker poll / DLQ dashboard
  @@index([authority, licenseNumber]) // duplicate/history lookup for operators
  @@index([professionalId])
  @@index([status, deadLetteredAt])
}

// Cold storage archive for closed regulator verification cases (>180 days)
model RegulatorVerificationCaseArchive {
  id             String               @default(uuid())
  professionalId String
  licenseId      String?

  authority     LicenseAuthority
  licenseNumber String

  dedupeKey String

  status RegulatorVerificationCaseStatus

  attempts         Int      @default(0)
  maxAttempts      Int      @default(5)
  nextAttemptAt    DateTime
  deadLetteredAt   DateTime?
  deadLetterReason String?

  confidence                 Float?
  confidenceReasons          Json?   @db.JsonB
  confidenceAlgorithmVersion String?
  confidenceBreakdown        Json?   @db.JsonB
  evidence                   Json?   @db.JsonB
  retryable                  Boolean @default(false)
  retryAfterSeconds          Int?
  manualFallbackReason       String?

  correlationId String?
  requestedAt   DateTime
  completedAt   DateTime?

  createdAt  DateTime
  updatedAt  DateTime
  archivedAt DateTime @default(now())

  @@id([id, archivedAt])
  @@index([authority, licenseNumber, archivedAt])
  @@index([professionalId, archivedAt])
  @@index([archivedAt])
}

// Immutable manual decision trail. Never updated in place - a correction is a
// new row - so this table doubles as the audit log required for high-risk
// four-eyes approval (a case needs two DISTINCT adminId rows with matching
// outcome before its RegulatorVerificationCase.status is allowed to flip to
// MANUALLY_VERIFIED/MANUALLY_REJECTED when highRiskReview = true).
model RegulatorVerificationDecision {
  id     String                    @id @default(uuid())
  caseId String
  case   RegulatorVerificationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  adminId    String
  admin      User    @relation("RegulatorVerificationDecisionMaker", fields: [adminId], references: [id])
  adminName  String // snapshot, matches AdminAuditLog convention
  adminEmail String // snapshot

  outcome      RegulatorVerificationDecisionOutcome
  reasonCode   String // required, e.g. "NAME_MISMATCH_CONFIRMED_SAME_PERSON"
  reasonNotes  String? @db.Text
  highRiskReview Boolean @default(false) // true when confidence < threshold or explicit regulator rejection is being overridden
  isSecondApprover Boolean @default(false) // true when this row satisfies the four-eyes requirement

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([adminId, createdAt])
}

// Append-only evidence view audit trail for regulator verification cases.
model RegulatorVerificationEvidenceView {
  id     String                    @id @default(uuid())
  caseId String
  case   RegulatorVerificationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  viewerId   String
  viewer     User   @relation("RegulatorVerificationEvidenceViewer", fields: [viewerId], references: [id])
  viewerRole String // snapshot, matches AdminAuditLog convention
  unredacted Boolean // true if this view included evidence.rawRecord

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([viewerId, createdAt])
  @@map("regulator_verification_evidence_views")
}
