// ========================================================
// 2. CORE SYSTEM MODELS
// ========================================================

model SystemSettings {
  id String @id @default("global")

  // Availability
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  allowedIPs         String[]

  // Onboarding
  publicSignup              Boolean @default(true)
  allowProfessionalSignup   Boolean @default(true)
  emailVerificationRequired Boolean @default(true)

  // Financials
  currency            String  @default("KES")
  commissionRate      Decimal @default(10.00) @db.Decimal(5, 2)
  vatPercentage       Decimal @default(16.00) @db.Decimal(5, 2)
  withholdingTaxRate  Decimal @default(5.00) @db.Decimal(5, 2)
  minWithdrawalAmount Decimal @default(1000.00) @db.Decimal(12, 2)

  // Verification & Compliance
  enforceStrictVerification   Boolean @default(true)
  enforceProfessionalLicenses Boolean @default(true)
  enableAutoVerifyNCA         Boolean @default(false)
  enableAutoVerifyERC         Boolean @default(false)
  enableAutoVerifyBORAQS      Boolean @default(false)
  enforcePropertyDocuments    Boolean @default(true)
  enableLandRegistryCheck     Boolean @default(false)
  enforceStorePermits         Boolean @default(true)
  requireTaxCompliance        Boolean @default(false)

  // Dynamic Rules (JSON)
  verificationRules Json @default("{}")
  featureFlags      Json @default("{}")

  // Support
  supportEmail   String  @default("support@buildmarket.co.ke")
  supportPhone   String?
  whatsappNumber String?

  // Security
  securityMFA        Boolean  @default(true)
  adminEmailAlerts   Boolean  @default(true)
  sessionTimeoutMins Int      @default(60)
  maxUploadSizeMB    Int      @default(10)
  allowedFileTypes   String[] @default(["application/pdf", "image/jpeg", "image/png", "image/webp"])

  // Versions
  termsVersion         String @default("1.0")
  privacyPolicyVersion String @default("1.0")
  minAppVersion        String @default("1.0.0")

  updatedAt DateTime @updatedAt
}

model User {
  id        String  @id @default(uuid())
  clerkId   String  @unique
  email     String  @unique
  firstName String?
  lastName  String?
  phone     String?
  avatar    String?

  // Status
  role              UserRole   @default(CLIENT)
  status            UserStatus @default(ACTIVE)
  isProfileComplete Boolean    @default(false)
  isEmailVerified   Boolean    @default(false)
  isPhoneVerified   Boolean    @default(false)

  // Legal
  termsAcceptedAt  DateTime?
  termsVersion     String?
  marketingConsent Boolean   @default(false)

  // Activity
  lastLoginAt  DateTime?
  lastActiveAt DateTime?
  metadata     Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Profiles
  clientProfile       ClientProfile?
  professionalProfile ProfessionalProfile?
  adminProfile        AdminProfile?

  // Relations
  projects        Project[]              @relation("ClientProjects")
  orders          Order[]                @relation("ClientOrders")
  reviews         Review[]               @relation("Reviewer")
  ideaBooks       IdeaBook[]             @relation("IdeaBookOwner")
  sharedIdeaBooks IdeaBookCollaborator[]

  // Messaging
  threadParticipants ThreadParticipant[]
  messages           Message[]           @relation("Sender")
  readReceipts       ReadReceipt[]

  // System
  analytics            UserAnalytics[]
  verifiedCertificates Certificate[]     @relation("CertificateVerifier")
  calendarEvents       CalendarEvent[]   @relation("ClientCalendarEvents")
  notifications        Notification[]
  adminAuditLogs       AdminAuditLog[]   @relation("AdminActions") // Relation to logs created by this admin
  propertyInquiries    PropertyInquiry[] @relation("InquirySender")

  // Upload Tracking
  uploadedProjectDocuments    ProjectDocument[]
  uploadedProjectImages       ProjectImage[]
  uploadedStoreDocuments      StoreDocument[]
  uploadedStoreImages         StoreImage[]
  uploadedPropertyDocuments   PropertyDocument[]
  uploadedPropertyImages      PropertyImage[]
  uploadedPortfolioImages     PortfolioImage[]
  uploadedIdeaBookAttachments IdeaBookAttachment[]
  uploadedPropertyAttachments PropertyAttachment[]
  leads                       Lead[]

  @@index([clerkId])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([phone])
}

model AdminProfile {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role          AdminRole @default(SUPPORT_AGENT)
  permissions   String[]
  department    String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  lastActiveAt  DateTime?
  internalNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AdminAuditLog {
  id      String  @id @default(uuid())
  adminId String?
  admin   User?   @relation("AdminActions", fields: [adminId], references: [id], onDelete: SetNull)

  adminName  String // Snapshot
  adminEmail String // Snapshot
  adminRole  String // Snapshot

  action   String
  severity AuditSeverity @default(INFO)
  status   AuditStatus   @default(SUCCESS)

  targetId   String
  targetType String
  details    Json?
  reason     String?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([severity])
}

// ========================================================
// 3. PROFILES (CLIENT & PROFESSIONAL)
// ========================================================

model ClientProfile {
  userId String     @id
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   ClientType @default(HOMEOWNER)

  companyName        String?
  kraPin             String?
  registrationNumber String?
  website            String?

  address      String?
  city         String?
  county       County?
  neighborhood String?
  landmark     String?
  zipCode      String?
  latitude     Float?
  longitude    Float?

  interests     String[]
  typicalBudget Decimal? @db.Decimal(12, 2)
  preferences   Json?

  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
  loyaltyPoints  Int       @default(0)
  membershipTier String    @default("STANDARD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]
}

model ProfessionalProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName     String
  profession      Profession?
  specializations String[]
  bio             String?     @db.Text
  website         String?
  portfolioUrl    String?
  socials         Json?

  city            String?
  county          County?
  country         String? @default("Kenya")
  latitude        Float?
  longitude       Float?
  serviceRadiusKm Int?    @default(20)

  availability   AvailabilityStatus @default(AVAILABLE)
  operatingHours Json?

  licenseNumber    String? @unique
  kraPin           String?
  isInsured        Boolean @default(false)
  insuranceDetails Json?
  yearsExperience  Int?

  verified           Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  submittedAt        DateTime?
  verifiedAt         DateTime?
  verifiedById       String?

  rating            Decimal @default(0.0) @db.Decimal(3, 2)
  reviewCount       Int     @default(0)
  completedProjects Int     @default(0)
  responseRate      Int     @default(100)

  minProjectBudget Decimal? @db.Decimal(12, 2)
  hourlyRate       Decimal? @db.Decimal(10, 2)
  acceptedPayments String[] @default(["MPESA", "BANK", "CASH"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services   ServiceCategory[]
  documents  ProfessionalDocument[]
  portfolios Portfolio[]

  stores         Store[]                   @relation("ProfessionalStores")
  projects       Project[]                 @relation("ProfessionalProjects")
  orders         Order[]                   @relation("ProfessionalOrders")
  reviews        Review[]                  @relation("ProfessionalReviews")
  certificates   Certificate[]
  calendarEvents CalendarEvent[]
  leads          Lead[]
  transactions   ProfessionalTransaction[]
  quotes         Quote[]
  properties     Property[]                @relation("AgentProperties")

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  @@index([verified])
  @@index([profession])
  @@index([county])
  @@index([rating])
  @@index([availability])
}

model ProfessionalDocument {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  type           String
  url            String
  fileKey        String              @unique
  mimeType       String
  size           Int
  verified       Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  verifiedAt     DateTime?
  notes          String?

  @@index([professionalId])
}

model Certificate {
  id                 String                        @id @default(uuid())
  professionalId     String
  professional       ProfessionalProfile           @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  name               String
  fileKey            String                        @unique
  mimeType           String?
  size               Int?
  issuer             String
  issueDate          DateTime?
  expiryDate         DateTime?
  fileUrl            String
  verificationStatus CertificateVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?                         @relation("CertificateVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  notes              String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@index([professionalId])
}

// ========================================================
// 4. SERVICES & CATEGORIES
// ========================================================

model ServiceCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  icon        String?
  imageUrl    String?

  professionType Profession?
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  isFeatured     Boolean     @default(false)

  metaTitle       String?
  metaDescription String?
  keywords        String[]

  services      Service[]
  professionals ProfessionalProfile[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Service {
  id         String          @id @default(uuid())
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  slug        String  @unique
  description String?
  icon        String?

  defaultUnit String?
  avgPriceMin Decimal? @db.Decimal(10, 2)
  avgPriceMax Decimal? @db.Decimal(10, 2)

  searchKeywords  String[]
  popularityScore Int      @default(0)

  professionals ProfessionalProfile[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?

  @@index([categoryId])
  @@index([slug])
}

// ========================================================
// 5. PROJECTS (MANAGEMENT & CONTRACTS)
// ========================================================

model Project {
  id String @id @default(uuid())

  clientId String
  client   User   @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)

  professionalId String?              @map("professionalId")
  professional   ProfessionalProfile? @relation("ProfessionalProjects", fields: [professionalId], references: [userId], onDelete: SetNull)

  portfolioId String?    @unique
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)

  title        String
  description  String?       @db.Text
  type         ProjectType   @default(RESIDENTIAL)
  contractType ContractType  @default(FULL_CONTRACT)
  status       ProjectStatus @default(PLANNING)
  isDisputed   Boolean       @default(false)

  location    String?
  siteAddress String?
  county      County?
  coordinates Json?

  budget   Decimal? @db.Decimal(12, 2)
  currency String   @default("KES")

  totalPaid            Decimal   @default(0) @db.Decimal(12, 2)
  totalInvoiced        Decimal   @default(0) @db.Decimal(12, 2)
  retentionPercentage  Decimal   @default(0) @db.Decimal(5, 2)
  retentionAmount      Decimal   @default(0) @db.Decimal(12, 2)
  retentionReleaseDate DateTime?

  startDate            DateTime?
  endDate              DateTime?
  actualCompletionDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  milestones ProjectMilestone[]
  images     ProjectImage[]
  documents  ProjectDocument[]

  professionalTransactions ProfessionalTransaction[]
  messageThreads           MessageThread[]
  calendarEvents           CalendarEvent[]
  reviews                  Review[]
  quotes                   Quote[]
  savedInIdeaBooks         SavedProject[]

  @@index([clientId])
  @@index([professionalId])
  @@index([status])
  @@index([county])
}

model ProjectMilestone {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?

  amount        Decimal? @db.Decimal(12, 2)
  isPaid        Boolean  @default(false)
  fundsInEscrow Boolean  @default(false)

  status          MilestoneStatus @default(PENDING)
  approvalStatus  ApprovalStatus  @default(PENDING)
  approvedAt      DateTime?
  rejectionReason String?

  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proofImages ProjectImage[]
  documents   ProjectDocument[]
}

model ProjectDocument {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title String
  type  ProjectDocumentType

  fileUrl  String
  fileKey  String @unique
  mimeType String
  size     Int

  version  Int     @default(1)
  isLatest Boolean @default(true)

  milestoneId String?
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id])
  status      ApprovalStatus    @default(APPROVED)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([milestoneId])
  @@index([type])
}

model ProjectImage {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id])

  fileUrl String
  fileKey String  @unique
  caption String?

  mimeType    String
  size        Int
  width       Int?
  height      Int?
  blurDataUrl String?

  category ProjectImageCategory?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([milestoneId])
  @@index([category])
}

// ========================================================
// 6. PORTFOLIOS (CASE STUDIES)
// ========================================================

model Portfolio {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)

  title       String
  slug        String      @unique
  description String?     @db.Text
  projectType ProjectType @default(RESIDENTIAL)
  tags        String[]

  location String?
  county   County?

  budget   Decimal? @db.Decimal(12, 2)
  currency String   @default("KES")

  durationValue  Int?
  durationUnit   ProjectDurationUnit @default(WEEKS)
  completionDate DateTime?

  linkedProjectId String?  @unique
  linkedProject   Project?
  isVerified      Boolean  @default(false)

  clientTestimonial String? @db.Text
  clientName        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images PortfolioImage[]

  @@index([professionalId])
  @@index([projectType])
}

model PortfolioImage {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  fileKey     String  @unique
  fileUrl     String
  mimeType    String
  size        Int
  width       Int
  height      Int
  blurDataUrl String?

  caption   String?
  category  PortfolioImageCategory @default(FINISHED_WORK)
  isMain    Boolean                @default(false)
  sortOrder Int                    @default(0)

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  savedInIdeaBooks SavedImage[]

  @@index([portfolioId])
  @@index([category])
}

// ========================================================
// 7. STORE & E-COMMERCE
// ========================================================

model Store {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation("ProfessionalStores", fields: [professionalId], references: [userId], onDelete: Cascade)

  name        String
  slug        String  @unique
  description String? @db.Text
  logoUrl     String?
  bannerUrl   String?

  contactPhone   String?
  whatsappNumber String?
  email          String?
  website        String?

  mpesaTillNumber String?
  mpesaPaybill    String?
  acceptsCard     Boolean @default(false)
  acceptsCash     Boolean @default(true)

  address      String
  city         String
  county       County?
  neighborhood String?
  zipCode      String?
  coordinates  Json?
  latitude     Float?
  longitude    Float?

  storeType        StoreType       @default(RETAIL)
  categories       StoreCategory[]
  deliveryOption   DeliveryOption  @default(PICKUP_ONLY)
  deliveryRadiusKm Int?
  baseDeliveryFee  Decimal?        @default(0) @db.Decimal(10, 2)
  minOrderValue    Decimal?        @default(0) @db.Decimal(10, 2)
  operatingHours   Json?
  isOpen           Boolean         @default(true)

  businessRegNo      String?
  kraPin             String?
  verified           Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  rejectionReason    String?

  featured    Boolean @default(false)
  rating      Decimal @default(0.0) @db.Decimal(3, 2)
  reviewCount Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  deletedAt   DateTime?

  images    StoreImage[]
  documents StoreDocument[]
  products  Product[]
  orders    Order[]         @relation("StoreOrders")
  reviews   Review[]        @relation("StoreReviews")

  @@index([professionalId])
  @@index([verified])
  @@index([storeType])
  @@index([county])
}

model StoreDocument {
  id       String            @id @default(uuid())
  storeId  String
  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type     StoreDocumentType
  fileKey  String            @unique
  fileUrl  String
  mimeType String
  size     Int

  status          DocumentStatus @default(PENDING)
  verified        Boolean        @default(false)
  verifiedAt      DateTime?
  rejectionReason String?
  issueDate       DateTime?
  expiryDate      DateTime?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
  @@index([status])
}

model StoreImage {
  id          String  @id @default(uuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fileKey     String  @unique
  fileUrl     String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  blurDataUrl String?

  category  StoreImageCategory @default(INTERIOR)
  caption   String?
  isMain    Boolean            @default(false)
  sortOrder Int                @default(0)

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([storeId])
}

model Product {
  id          String    @id @default(uuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal   @db.Decimal(12, 2)
  imageUrl    String?
  category    String
  inStock     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  orderItems       OrderItem[]
  reviews          Review[]
  savedInIdeaBooks SavedProduct[]
}

model Order {
  id             String               @id @default(uuid())
  clientId       String
  client         User                 @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)
  storeId        String?
  store          Store?               @relation("StoreOrders", fields: [storeId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   ProfessionalProfile? @relation("ProfessionalOrders", fields: [professionalId], references: [userId], onDelete: SetNull)

  items         OrderItem[]
  totalAmount   Decimal     @db.Decimal(12, 2)
  status        OrderStatus @default(PENDING)
  paymentMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  reviews  Review[]
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name             String
  price            Decimal  @db.Decimal(12, 2)
  quantity         Int
  snapshotImageUrl String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  transactionId String        @unique
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  @@index([orderId])
  @@index([transactionId])
}

// ========================================================
// 8. REAL ESTATE (PROPERTIES)
// ========================================================

model Property {
  id          String           @id @default(uuid())
  title       String
  slug        String           @unique
  description String?          @db.Text
  type        PropertyType
  category    PropertyCategory

  price           Decimal  @db.Decimal(12, 2)
  currency        String   @default("KES")
  priceNegotiable Boolean  @default(false)
  serviceCharge   Decimal? @default(0) @db.Decimal(10, 2)
  depositRequired String?
  paymentTerms    String?

  tenure              PropertyTenure? @default(FREEHOLD)
  leaseYearsRemaining Int?
  titleDeedReady      Boolean         @default(false)

  bedrooms         Int?
  bathrooms        Int?
  parkingSpaces    Int?
  buildingSize     Float?
  plotSize         Float?
  areaUnit         AreaUnit         @default(SQ_METERS)
  yearBuilt        Int?
  furnishing       FurnishingStatus @default(UNFURNISHED)
  completionStatus CompletionStatus @default(READY_TO_MOVE)

  location        String
  address         String?
  county          County?
  constituency    String?
  neighbourhood   String?
  coordinates     Json?
  latitude        Float?
  longitude       Float?
  nearbyLandmarks Json?

  hasBorehole        Boolean  @default(false)
  hasBackupGenerator Boolean  @default(false)
  hasElevator        Boolean  @default(false)
  hasCCTV            Boolean  @default(false)
  isGatedCommunity   Boolean  @default(false)
  features           String[]

  status             PropertyStatus     @default(AVAILABLE)
  featured           Boolean            @default(false)
  verified           Boolean            @default(false)
  verifiedAt         DateTime?
  submittedAt        DateTime?
  rejectionReason    String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?

  viewCount    Int @default(0)
  inquiryCount Int @default(0)

  agentId String
  agent   ProfessionalProfile @relation("AgentProperties", fields: [agentId], references: [userId], onDelete: Restrict)

  images      PropertyImage[]
  attachments PropertyAttachment[]
  documents   PropertyDocument[]
  inquiries   PropertyInquiry[]

  floorPlanUrl   String?
  videoUrl       String?
  virtualTourUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([location])
  @@index([price])
  @@index([county])
  @@index([status])
  @@index([completionStatus])
}

model PropertyDocument {
  id         String               @id @default(uuid())
  propertyId String
  property   Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       PropertyDocumentType
  fileKey    String               @unique
  url        String
  mimeType   String
  size       Int

  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedById    String?
  issueDate       DateTime?
  expiryDate      DateTime?
  isPrivate       Boolean        @default(true)

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
}

model PropertyImage {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fileKey     String   @unique
  url         String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  blurDataUrl String?

  caption   String?
  category  ImageCategory @default(EXTERIOR)
  tags      String[]
  isMain    Boolean       @default(false)
  sortOrder Int           @default(0)

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([propertyId])
  @@index([category])
}

model PropertyAttachment {
  id            String         @id @default(uuid())
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title         String
  type          AttachmentType
  fileKey       String         @unique
  fileUrl       String
  mimeType      String
  size          Int
  downloadCount Int            @default(0)
  uploadedById  String
  uploadedBy    User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([propertyId])
}

model PropertyInquiry {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?   @relation("InquirySender", fields: [senderId], references: [id], onDelete: SetNull)

  name      String?
  email     String?
  phone     String?
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

// ========================================================
// 9. FINANCIALS & QUOTES
// ========================================================

model Quote {
  id             String              @id @default(uuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  clientId       String
  client         ClientProfile       @relation(fields: [clientId], references: [userId], onDelete: Cascade)

  version         Int     @default(1)
  isLatest        Boolean @default(true)
  previousQuoteId String?

  materialsTotal Decimal @default(0) @db.Decimal(12, 2)
  laborTotal     Decimal @default(0) @db.Decimal(12, 2)
  logisticsTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  currency       String  @default("KES")

  title             String
  description       String?  @db.Text
  validUntil        DateTime
  paymentTerms      String?  @db.Text
  estimatedDuration Int?

  status          QuoteStatus @default(DRAFT)
  viewedAt        DateTime?
  respondedAt     DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       QuoteItem[]
  attachments QuoteAttachment[]

  @@index([projectId])
  @@index([status])
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit        String
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  category    String?
  sortOrder   Int     @default(0)

  @@index([quoteId])
}

model QuoteAttachment {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fileKey   String   @unique
  fileUrl   String
  title     String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([quoteId])
}

model ProfessionalTransaction {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  leadId         String?
  subscriptionId String?

  description String
  type        TransactionType
  category    TransactionCategory @default(PROJECT_PAYMENT)
  method      PaymentMethod       @default(MPESA)

  amount      Decimal @db.Decimal(12, 2)
  platformFee Decimal @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  netAmount   Decimal @default(0) @db.Decimal(12, 2)
  currency    String  @default("KES")

  referenceCode    String? @unique
  providerMetadata Json?

  status       TransactionStatus @default(PENDING)
  failedReason String?
  date         DateTime          @default(now())
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([professionalId])
  @@index([referenceCode])
}

// ========================================================
// 10. CRM & CALENDAR
// ========================================================

model Lead {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  clientId       String?
  client         User?               @relation(fields: [clientId], references: [id], onDelete: SetNull)

  clientName  String
  clientEmail String?
  clientPhone String?
  title       String
  description String?     @db.Text
  projectType ProjectType @default(RESIDENTIAL)

  location String?
  county   County?

  budget    Decimal? @db.Decimal(12, 2)
  budgetMin Decimal? @db.Decimal(12, 2)
  budgetMax Decimal? @db.Decimal(12, 2)
  currency  String   @default("KES")

  status     LeadStatus   @default(NEW)
  priority   LeadPriority @default(MEDIUM)
  source     LeadSource   @default(PLATFORM_SEARCH)
  lostReason LostReason?
  wonAt      DateTime?

  notes           String?   @db.Text
  lastContactedAt DateTime?
  followUpDate    DateTime?
  reminderSent    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId])
  @@index([status])
  @@index([county])
}

model CalendarEvent {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  clientId       String?
  client         User?               @relation("ClientCalendarEvents", fields: [clientId], references: [id], onDelete: SetNull)
  guestEmails    String[]

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title       String
  description String?             @db.Text
  type        CalendarEventType   @default(MEETING)
  status      CalendarEventStatus @default(SCHEDULED)

  startDate      DateTime
  endDate        DateTime
  isAllDay       Boolean  @default(false)
  timeZone       String   @default("Africa/Nairobi")
  recurrenceRule String?

  location   String?
  meetingUrl String?
  reminders  Int[]   @default([30])

  externalEventId String? @unique
  color           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId])
  @@index([startDate])
}

// ========================================================
// 11. COMMUNICATION & IDEAS
// ========================================================

model MessageThread {
  id            String     @id @default(uuid())
  type          ThreadType @default(DIRECT)
  subject       String?
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lastMessage   String?    @db.Text
  lastMessageAt DateTime?
  metadata      Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  participants ThreadParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ThreadParticipant {
  id       String        @id @default(uuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  nickname String?
  role     ParticipantRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  unreadCount Int       @default(0)
  lastReadAt  DateTime?
  isMuted     Boolean   @default(false)
  isArchived  Boolean   @default(false)
  isPinned    Boolean   @default(false)

  @@unique([threadId, userId])
  @@index([userId, unreadCount])
}

model Message {
  id       String        @id @default(uuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String
  sender   User          @relation("Sender", fields: [senderId], references: [id])

  content String      @db.Text
  type    MessageType @default(TEXT)

  replyToId    String?
  replyTo      Message?      @relation("ReplyHistory", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]     @relation("ReplyHistory")
  readReceipts ReadReceipt[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  attachments Attachment[]

  @@index([threadId, createdAt])
}

model ReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileKey   String?  @unique
  filename  String
  size      Int?
  mimeType  String?
  createdAt DateTime @default(now())

  @@index([messageId])
}

model Notification {
  id       String                @id @default(uuid())
  userId   String
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  message  String                @db.Text
  type     NotificationType      @default(INFO)
  priority NotificationPriority  @default(MEDIUM)
  channels NotificationChannel[] @default([IN_APP])

  metadata       Json?
  link           String?
  isRead         Boolean                    @default(false)
  readAt         DateTime?
  deliveryStatus NotificationDeliveryStatus @default(QUEUED)
  error          String?

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId, isRead])
}

model Review {
  id         String @id @default(uuid())
  reviewerId String
  reviewer   User   @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  professionalId String?
  professional   ProfessionalProfile? @relation("ProfessionalReviews", fields: [professionalId], references: [userId], onDelete: Cascade)
  storeId        String?
  store          Store?               @relation("StoreReviews", fields: [storeId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)

  isVerified Boolean  @default(false)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  type       ReviewType
  rating     Int
  subRatings Json?
  title      String?
  comment    String?    @db.Text

  images        ReviewImage[]
  status        ReviewStatus  @default(PENDING)
  replyComment  String?       @db.Text
  replyAt       DateTime?
  helpfulCount  Int           @default(0)
  reportedCount Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([professionalId])
  @@index([storeId])
}

model ReviewImage {
  id          String   @id @default(uuid())
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  fileKey     String   @unique
  fileUrl     String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  blurDataUrl String?
  createdAt   DateTime @default(now())

  @@index([reviewId])
}

model IdeaBook {
  id       String @id @default(uuid())
  clientId String
  client   User   @relation("IdeaBookOwner", fields: [clientId], references: [id], onDelete: Cascade)

  title       String
  slug        String           @unique
  description String?          @db.Text
  category    IdeaBookCategory @default(WHOLE_HOUSE)
  privacy     IdeaBookPrivacy  @default(PUBLIC)

  collaborators IdeaBookCollaborator[]
  savedProducts SavedProduct[]
  savedProjects SavedProject[]
  savedImages   SavedImage[]
  attachments   IdeaBookAttachment[]

  viewCount Int      @default(0)
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([category])
}

model IdeaBookCollaborator {
  id         String   @id @default(uuid())
  ideaBookId String
  ideaBook   IdeaBook @relation(fields: [ideaBookId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canEdit    Boolean  @default(false)
  addedAt    DateTime @default(now())

  @@unique([ideaBookId, userId])
}

model SavedProduct {
  id         String   @id @default(uuid())
  ideaBookId String
  ideaBook   IdeaBook @relation(fields: [ideaBookId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  note       String?
  savedAt    DateTime @default(now())

  @@unique([ideaBookId, productId])
}

model SavedProject {
  id         String   @id @default(uuid())
  ideaBookId String
  ideaBook   IdeaBook @relation(fields: [ideaBookId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  note       String?
  savedAt    DateTime @default(now())

  @@unique([ideaBookId, projectId])
}

model SavedImage {
  id               String         @id @default(uuid())
  ideaBookId       String
  ideaBook         IdeaBook       @relation(fields: [ideaBookId], references: [id], onDelete: Cascade)
  portfolioImageId String
  portfolioImage   PortfolioImage @relation(fields: [portfolioImageId], references: [id], onDelete: Cascade)
  note             String?
  savedAt          DateTime       @default(now())

  @@unique([ideaBookId, portfolioImageId])
}

model IdeaBookAttachment {
  id           String   @id @default(uuid())
  ideaBookId   String
  ideaBook     IdeaBook @relation(fields: [ideaBookId], references: [id], onDelete: Cascade)
  sourceUrl    String?
  fileKey      String   @unique
  fileUrl      String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  blurDataUrl  String?
  caption      String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ideaBookId])
}

// ========================================================
// 12. ANALYTICS
// ========================================================

model UserAnalytics {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType  AnalyticsEntityType @default(PROFILE)
  entityId    String?
  period      AnalyticsPeriod     @default(DAILY)
  startDate   DateTime
  endDate     DateTime
  views       Int                 @default(0)
  uniqueViews Int                 @default(0)
  clicks      Int                 @default(0)
  impressions Int                 @default(0)
  revenue     Decimal             @default(0) @db.Decimal(12, 2)
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([userId, entityType, entityId, period, startDate])
  @@index([userId, startDate])
}

model AnalyticsEvent {
  id         String              @id @default(uuid())
  ownerId    String
  entityType AnalyticsEntityType
  entityId   String?
  eventType  AnalyticsEventType
  viewerId   String?
  sessionId  String?
  ipAddress  String?
  userAgent  String?
  source     String?
  metadata   Json?
  createdAt  DateTime            @default(now())

  @@index([ownerId, createdAt])
}
