// ========================================================
// 2. CORE SYSTEM MODELS
// ========================================================

model SystemSettings {
  id String @id @default("global")

  // Availability
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  allowedIPs         String[]

  // Onboarding
  publicSignup              Boolean @default(true)
  allowProfessionalSignup   Boolean @default(true)
  emailVerificationRequired Boolean @default(true)

  // Financials
  currency           String  @default("KES")
  minWithdrawalKes   Decimal @default(1000.00) @db.Decimal(10, 2)
  maxWithdrawalKes   Decimal @default(150000.00) @db.Decimal(10, 2) // M-Pesa limit
  platformCommission Decimal @default(5.00) @db.Decimal(5, 2)
  vatRate            Decimal @default(16.00) @db.Decimal(5, 2)
  withholdingTaxRate Decimal @default(5.00) @db.Decimal(5, 2)

  // M-Pesa Integration Config
  mpesaEnv               String  @default("sandbox") // sandbox/production
  mpesaShortCode         String?
  mpesaPasskey           String? // Encrypted
  mpesaConsumerKey       String? // Encrypted
  mpesaConsumerSecret    String? // Encrypted
  mpesaInitiatorName     String?
  mpesaInitiatorPassword String? // Encrypted

  // KRA Integration
  kraApiEnabled       Boolean @default(false)
  kraTaxPinValidation Boolean @default(false)

  // Verification & Compliance
  verificationSlaHours        Int     @default(48)
  enforceStrictVerification   Boolean @default(true)
  enforceProfessionalLicenses Boolean @default(true)
  enableAutoVerifyNCA         Boolean @default(false)
  enableAutoVerifyEPRA        Boolean @default(false) // Renamed from ERC
  enableAutoVerifyBORAQS      Boolean @default(false)
  enableAutoVerifyEBK         Boolean @default(false)
  enableAutoVerifyEARB        Boolean @default(false)
  enableAutoVerifyVRB         Boolean @default(false)
  enableAutoVerifyISK         Boolean @default(false)

  enforcePropertyDocuments    Boolean @default(true)
  enableLandRegistryCheck     Boolean @default(false)
  enforceStorePermits         Boolean @default(true)
  requireTaxCompliance        Boolean @default(false)

  // Dynamic Rules (JSON)
  verificationRules Json @default("{}")
  featureFlags      Json @default("{}")

  // Support
  supportEmail   String  @default("support@buildmarket.co.ke")
  supportPhone   String?
  whatsappNumber String?

  // Security
  securityMFA        Boolean  @default(true)
  adminEmailAlerts   Boolean  @default(true)
  sessionTimeoutMins Int      @default(60)
  maxUploadSizeMB    Int      @default(10)
  allowedFileTypes   String[] @default(["application/pdf", "image/jpeg", "image/png", "image/webp"])

  // Versions
  termsVersion         String @default("1.0")
  privacyPolicyVersion String @default("1.0")
  minAppVersion        String @default("1.0.0")

  updatedAt DateTime @updatedAt
}

// Idempotency for M-Pesa & external webhooks
model IdempotencyKey {
  id         String            @id @default(uuid())
  key        String            @unique // SHA256 of transaction details
  scope      String // 'mpesa_stk', 'withdrawal', 'project_creation', 'property'
  operation  String // "PATCH", "DELETE", etc.
  status     IdempotencyStatus
  response   Json?             @db.JsonB
  storeId    String?
  propertyId String?
  userId     String
  actorClerkId String?
  appUserId    String?
  expiresAt  DateTime
  createdAt  DateTime          @default(now())

  store    Store?    @relation(fields: [storeId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([key, scope])
  @@index([scope, actorClerkId, status])
  @@index([appUserId])
  @@index([expiresAt]) // For cleanup jobs
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

enum OnboardingWorkflowState {
  NOT_STARTED
  ROLE_SELECTED
  PROFILE_SUBMITTED
  COMPLETED
  PENDING_VERIFICATION
  FAILED_RETRYABLE
}

model OnboardingState {
  userId          String                  @id
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  state           OnboardingWorkflowState @default(NOT_STARTED)
  role            UserRole?
  currentStep     Int                     @default(1)
  completedAt     DateTime?
  lastErrorCode   String?
  version         Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  transitions     OnboardingTransition[]

  @@index([state, role])
  @@index([updatedAt])
}

model OnboardingTransition {
  id              String                  @id @default(uuid())
  userId          String
  onboardingState OnboardingState         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  idempotencyKey  String                  @unique
  fromState       OnboardingWorkflowState
  toState         OnboardingWorkflowState
  actorClerkId    String
  correlationId   String
  reason          String?
  createdAt       DateTime                @default(now())

  @@index([userId, createdAt])
  @@index([actorClerkId, createdAt])
}

model AuthOutboxEvent {
  id             String   @id @default(uuid())
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json     @db.JsonB
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

model User {
  id          String  @id @default(uuid())
  clerkId     String  @unique
  email       String  @unique @db.Citext // Case-insensitive for emails
  firstName   String?
  lastName    String?
  displayName String? // Computed fallback
  phone       String?
  avatar      String?
  bio         String? @db.Text

  // Status
  role              UserRole   @default(CLIENT)
  status            UserStatus @default(ONBOARDING)
  isProfileComplete Boolean    @default(false)
  isEmailVerified   Boolean    @default(false)
  isPhoneVerified   Boolean    @default(false)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?

  // Legal
  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?
  marketingConsent  Boolean   @default(false)
  dataRetentionDays Int? // GDPR: null = indefinite, 0 = delete asap

  // Activity
  lastLoginAt           DateTime?
  lastActiveAt          DateTime?
  loginCount            Int       @default(0)
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime?
  passwordResetRequired Boolean   @default(false)
  metadata              Json?     @db.JsonB

  // GDPR requires granular consent
  emailMarketingConsent Boolean @default(false)
  smsMarketingConsent   Boolean @default(false)
  analyticsConsent      Boolean @default(false)

  // Withdrawal timestamps
  marketingConsentWithdrawnAt DateTime?

  // GDPR/Kenya DPA Consent Tracking
  consents ConsentRecord[]

  // Data Retention 
  scheduledDeletionAt DateTime?

  // Deletion Audit Trail
  deletionRequestedAt  DateTime?
  deletionReason       String? // USER_REQUEST, INACTIVE_ACCOUNT, VIOLATION
  anonymizedAt         DateTime?
  anonymizationBatchId String? // For tracking bulk anonymization jobs

  // Encryption flags for sensitive data
  isEncrypted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete with cascade handling
  deletedAt DateTime?
  deletedBy String? // Admin who initiated

  // Profiles
  clientProfile       ClientProfile?
  professionalProfile ProfessionalProfile?
  adminProfile        AdminProfile?
  onboardingState     OnboardingState?

  // Assets ownership (centralized)
  uploads       Asset[]        @relation("Uploader")
  directUploads DirectUpload[]

  // Auth tokens management
  refreshTokens RefreshToken[]

  // Relations
  projects        Project[]              @relation("ClientProjects")
  orders          Order[]                @relation("ClientOrders")
  reviews         Review[]               @relation("Reviewer")
  ideaBooks       IdeaBook[]             @relation("IdeaBookOwner")
  sharedIdeaBooks IdeaBookCollaborator[]

  // System
  analytics            UserAnalytics[]
  verifiedCertificates ProfessionalDocument[] @relation("DocumentVerifier")
  verifiedLicenses     ProfessionalLicense[]  @relation("LicenseVerifier")
  regulatorVerificationDecisions RegulatorVerificationDecision[] @relation("RegulatorVerificationDecisionMaker")
  regulatorVerificationEvidenceViews RegulatorVerificationEvidenceView[] @relation("RegulatorVerificationEvidenceViewer")
  verifiedStores       Store[]                @relation("StoreVerifier")
  verifiedProperties   Property[]             @relation("PropertyVerifier")
  calendarEvents       CalendarEvent[]        @relation("ClientCalendarEvents")
  notifications        Notification[]
  adminAuditLogs       AdminAuditLog[]        @relation("AdminActions") // Relation to logs created by this admin
  propertyInquiries    PropertyInquiry[]      @relation("InquirySender")
  auditLogs            AuditLog[]             @relation("AuditLogs")

  // Upload Tracking
  uploadedProjectDocuments    ProjectDocument[]
  uploadedProjectImages       ProjectImage[]
  uploadedStoreDocuments      StoreDocument[]
  uploadedStoreImages         StoreImage[]
  uploadedPropertyDocuments   PropertyDocument[]
  uploadedPropertyImages      PropertyImage[]
  uploadedPortfolioImages     PortfolioImage[]
  uploadedIdeaBookAttachments IdeaBookAttachment[]
  uploadedPropertyAttachments PropertyAttachment[]
  leads                       Lead[]
  marketplaceLeads            MarketplaceLead[]      @relation("ClientMarketplaceLeads")
  newsletterSubscribers       NewsletterSubscriber[]

  @@index([clerkId])
  @@index([email])
  @@index([role])
  @@index([status, deletedAt])
  @@index([createdAt])
  @@index([phone])
  @@index([status, scheduledDeletionAt])
  @@index([anonymizedAt])
  @@map("users") // Explicit naming convention
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // Store hash only
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  @@index([userId, expiresAt])
}

model AdminProfile {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role          AdminRole @default(SUPPORT_AGENT)
  permissions   String[]
  department    String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  lastActiveAt  DateTime?
  internalNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AdminAuditLog {
  id      String  @default(uuid())
  adminId String?
  admin   User?   @relation("AdminActions", fields: [adminId], references: [id], onDelete: SetNull)

  adminName  String // Snapshot
  adminEmail String // Snapshot
  adminRole  String // Snapshot

  action   String // "PROJECT_CREATED", "PAYMENT_RECEIVED", etc.
  severity AuditSeverity @default(INFO)
  status   AuditStatus   @default(SUCCESS)

  targetId   String
  targetType String
  details    Json?
  reason     String?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@id([id, createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([severity, createdAt])
}

// ========================================================
// 3. PROFILES (CLIENT & PROFESSIONAL)
// ========================================================

// Team management for construction firms (multi-user profiles)
model TeamMember {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)

  userId        String? @unique // Optional: if team member is also a platform user
  email         String
  name          String
  role          String // "Project Manager", "Site Supervisor", etc.
  canAcceptJobs Boolean @default(false)

  createdAt DateTime @default(now())
}

// LOCATION PATTERN: Standardized geographic fields
// - city: String?
// - county: County?
// - latitude: Float?
// - longitude: Float?
// - location: Json? (GeoJSON Point: {"type":"Point","coordinates":[lng,lat]})
// - coordinates: Json? (simple {lat,lng} or GeoJSON)
model ClientProfile {
  userId String     @id
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   ClientType @default(HOMEOWNER)

  companyName         String?
  companyRegistration String? // CR12 number
  kraPin              String? @unique
  vatRegistered       Boolean @default(false)
  website             String?

  address      String?
  city         String?
  county       County?
  neighborhood String?
  landmark     String?
  zipCode      String?
  latitude     Float?
  longitude    Float?
  location     Json?   @db.JsonB // PostGIS point or {lat, lng}

  budgetRangeMin Decimal? @db.Decimal(12, 2)
  budgetRangeMax Decimal? @db.Decimal(12, 2)
  interests      String[]
  preferences    Json?    @db.JsonB

  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
  loyaltyPoints  Int       @default(0)
  membershipTier String    @default("STANDARD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@index([county])
  @@index([kraPin])
  @@index([userId, isVerified])
}

model ProfessionalProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName  String
  profession   Profession?
  slug         String?     @unique
  bio          String?     @db.Text
  portfolioUrl String?

  // Contact (Business)
  businessEmail String?
  businessPhone String?
  website       String?
  socials       Json?   @db.JsonB // {facebook, instagram, linkedin}

  city            String?
  county          County?
  country         String? @default("Kenya")
  latitude        Float?
  longitude       Float?
  location        Json?   @db.JsonB // GeoJSON Point
  serviceRadiusKm Int?    @default(20)

  availability   AvailabilityStatus @default(AVAILABLE)
  operatingHours Json?              @db.JsonB

  kraPin                String?
  isInsured             Boolean   @default(false)
  insuranceExpiry       DateTime?
  insuranceProvider     String?
  insurancePolicyNumber String?
  yearsExperience       Int?

  verified           Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedById       String?

  rating            Decimal @default(0.0) @db.Decimal(3, 2)
  reviewCount       Int     @default(0)
  completedProjects Int     @default(0)
  projectCount      Int     @default(0)
  responseRate      Float   @default(0) // Percentage
  responseTime      Int     @default(0) // Average minutes

  minProjectBudget Decimal? @db.Decimal(12, 2)
  hourlyRate       Decimal? @db.Decimal(10, 2)
  acceptedPayments String[] @default(["MPESA", "BANK", "CASH"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents       ProfessionalDocument[]
  portfolios      Portfolio[]
  licenses        ProfessionalLicense[]
  stores          Store[]                   @relation("ProfessionalStores")
  projects        Project[]                 @relation("ProfessionalProjects")
  orders          Order[]                   @relation("ProfessionalOrders")
  reviews         Review[]                  @relation("ProfessionalReviews")
  calendarEvents  CalendarEvent[]
  leads                     Lead[]
  marketplaceRoutingEvents  MarketplaceLeadRoutingEvent[] @relation("ProfessionalMarketplaceRouting")
  transactions              ProfessionalTransaction[]
  quotes          Quote[]
  properties      Property[]                @relation("AgentProperties")
  offeredServices ProfessionalService[]
  teamMembers     TeamMember[] // For agencies/companies

  @@index([slug])
  @@index([profession, county, verificationStatus]) // Main search index
  @@index([kraPin])
  @@index([rating, reviewCount])
  @@index([availability])
  @@index([location]) // PostGIS index (if using PostGIS extension)
}

model ProfessionalLicense {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)

  authority     LicenseAuthority
  licenseNumber String
  category      String? // NCA Category (e.g., "NCA 1", "NCA 2")     

  // Validation
  status          VerificationStatus @default(PENDING)
  validFrom       DateTime
  validUntil      DateTime?
  isAnnualRenewal Boolean            @default(true)

  // OLD (deprecating)
  fileKey  String? @unique // "user123/timestamp_doc.pdf"
  fileUrl  String? // "https://s3.../user123/timestamp_doc.pdf"
  size     Int?
  mimeType String?

  // Storage
  assetId String?
  asset   Asset?  @relation("ProfessionalLicenseAssets", fields: [assetId], references: [id])

  // Additional logging for sensitive data access
  accessLog Json? // [{userId: "admin123", action: "VIEW", at: "2026-01-..."}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?     @relation("LicenseVerifier", fields: [verifiedById], references: [id])
  verificationMethod String? // "MANUAL", "API_NCA", "API_EBK"
  notes              String?   @db.Text

  verificationCases RegulatorVerificationCase[]

  @@unique([professionalId, authority, licenseNumber])
  @@index([authority, licenseNumber]) // For duplicate detection
  @@index([validUntil]) // Expiry notifications 
}

model ProfessionalDocument {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)

  category DocumentCategory @default(OTHER)
  title    String // e.g. "Bachelor of Architecture"

  issuer     String? // e.g. "University of Nairobi"
  issueDate  DateTime?
  expiryDate DateTime? // Useful for Insurance/Tax

  // OLD (deprecating)
  fileKey  String? @unique // "user123/timestamp_doc.pdf"
  fileUrl  String? // "https://s3.../user123/timestamp_doc.pdf"
  size     Int?
  mimeType String?

  // Storage
  assetId String?
  asset   Asset?  @relation("ProfessionalDocumentAssets", fields: [assetId], references: [id])

  // Additional logging for sensitive data access
  accessLog Json? // [{userId: "admin123", action: "VIEW", at: "2026-01-..."}]

  verifiedById String?
  verifiedBy   User?   @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  status          VerificationStatus @default(PENDING)
  verifiedAt      DateTime?
  rejectionReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([professionalId, category])
  @@index([status])
}

model ProfessionalService {
  id String @id @default(uuid())

  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  price       Decimal? @db.Decimal(12, 2)
  pricingUnit String?

  yearsExperience Int?
  isPrimary       Boolean @default(false)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@unique([professionalId, serviceId])
  @@index([serviceId])
  @@index([professionalId])
}

// Materialized view support (manual or using Prisma views)
model DailyProfessionalStats {
  id             String   @id @default(uuid())
  professionalId String
  date           DateTime

  views       Int     @default(0)
  inquiries   Int     @default(0)
  projectsWon Int     @default(0)
  revenue     Decimal @default(0) @db.Decimal(12, 2)

  @@unique([professionalId, date])
  @@index([professionalId, date])
}

// ========================================================
// 4. SERVICES & CATEGORIES
// ========================================================

model ServiceCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  icon        String?
  imageUrl    String?

  professionType Profession?
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  isFeatured     Boolean     @default(false)

  metaTitle       String?
  metaDescription String?
  keywords        String[]

  services Service[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Service {
  id         String          @id @default(uuid())
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  slug        String                @unique
  description String?
  icon        String?
  offeredBy   ProfessionalService[]

  defaultUnit String?
  avgPriceMin Decimal? @db.Decimal(10, 2)
  avgPriceMax Decimal? @db.Decimal(10, 2)

  searchKeywords  String[]
  popularityScore Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@index([slug])
}

// ========================================================
// 5. PROJECTS (MANAGEMENT & CONTRACTS)
// ========================================================

model Project {
  id String @id @default(uuid())

  clientId String
  client   User   @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)

  professionalId String?              @map("professionalId")
  professional   ProfessionalProfile? @relation("ProfessionalProjects", fields: [professionalId], references: [userId], onDelete: SetNull)

  portfolioId String?    @unique
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)

  title       String
  description String?     @db.Text
  type        ProjectType @default(RESIDENTIAL)

  contractType       ContractType     @default(FULL_CONTRACT)
  contractSignedAt   DateTime?
  contractDocumentId String?          @unique
  contractDocument   ProjectDocument? @relation("ContractDocument")

  status            ProjectStatus    @default(PLANNING)
  isDisputed        Boolean          @default(false)
  disputeReason     String?          @db.Text
  disputeResolvedAt DateTime?
  disputeResolution String?          @db.Text
  disputeDocumentId String?          @unique
  disputeDocument   ProjectDocument? @relation("DisputeDocument")

  location    String? @db.Text
  siteAddress String?
  county      County?
  coordinates Json?   @db.JsonB

  // Financials
  budgetMin   Decimal? @db.Decimal(12, 2)
  budgetMax   Decimal? @db.Decimal(12, 2)
  agreedPrice Decimal? @db.Decimal(12, 2) // Final contract price

  totalPaid            Decimal   @default(0) @db.Decimal(12, 2)
  totalInvoiced        Decimal   @default(0) @db.Decimal(12, 2)
  retentionPercentage  Decimal   @default(0) @db.Decimal(5, 2)
  retentionAmount      Decimal   @default(0) @db.Decimal(12, 2)
  retentionReleaseDate DateTime?

  startDate            DateTime?
  endDate              DateTime?
  actualCompletionDate DateTime?
  version              Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  milestones         ProjectMilestone[]
  escrowTransactions EscrowTransaction[]
  images             ProjectImage[]
  documents          ProjectDocument[]   @relation("ProjectDocuments")

  professionalTransactions ProfessionalTransaction[]
  messageThreads           MessageThread[]
  calendarEvents           CalendarEvent[]
  reviews                  Review[]
  quotes                   Quote[]
  savedInIdeaBooks         SavedProject[]

  @@index([clientId, status])
  @@index([professionalId, status])
  @@index([county])
  @@index([title, description]) // PostgreSQL FTS index
}

model ProjectMilestone {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?

  amount Decimal? @db.Decimal(12, 2)
  isPaid Boolean  @default(false)

  // Escrow linkage
  escrowId String?            @unique
  escrow   EscrowTransaction? @relation(fields: [escrowId], references: [id])

  status          MilestoneStatus @default(PENDING)
  approvalStatus  ApprovalStatus  @default(PENDING)
  approvedAt      DateTime?
  rejectionReason String?

  dueDate     DateTime?
  completedAt DateTime?
  version     Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proofImages ProjectImage[]
  documents   ProjectDocument[] @relation("MilestoneDocuments")
}

model ProjectDocument {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation("ProjectDocuments", fields: [projectId], references: [id], onDelete: Cascade)

  // For contract and dispute document (unique 1:1)
  contractProjectId String?  @unique
  contractProject   Project? @relation("ContractDocument", fields: [contractProjectId], references: [contractDocumentId])

  disputeProjectId String?  @unique
  disputeProject   Project? @relation("DisputeDocument", fields: [disputeProjectId], references: [disputeDocumentId])

  title String
  type  ProjectDocumentType

  // OLD (deprecating)
  fileUrl  String?
  fileKey  String? @unique
  mimeType String?
  size     Int?

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  version  Int     @default(1)
  isLatest Boolean @default(true)

  milestoneId String?
  milestone   ProjectMilestone? @relation("MilestoneDocuments", fields: [milestoneId], references: [id])
  status      ApprovalStatus    @default(APPROVED)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([milestoneId])
  @@index([type])
}

model ProjectImage {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id])

  // OLD (deprecating)
  fileKey String? // Nullable during migration
  fileUrl String? // Nullable

  caption String?

  mimeType    String?
  size        Int?
  width       Int?
  height      Int?
  blurDataUrl String?

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  category ProjectImageCategory?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([milestoneId])
  @@index([category])
}

// Escrow/Ledger System for Milestone Payments
model EscrowTransaction {
  id String @id @default(uuid())

  // Linkage
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id])
  milestoneId String?           @unique
  milestone   ProjectMilestone? @relation

  // Financials
  amount         Decimal @db.Decimal(12, 2)
  platformFee    Decimal @default(0) @db.Decimal(12, 2)
  vatAmount      Decimal @default(0) @db.Decimal(12, 2)
  withholdingTax Decimal @default(0) @db.Decimal(12, 2)

  // Flow
  status EscrowStatus @default(PENDING_FUNDING)

  // Funding
  fundedAt   DateTime?
  fundingRef String?   @unique // M-Pesa transaction code

  // Release
  releasedAt   DateTime?
  releasedToId String? // Professional user ID
  releaseRef   String?   @unique

  // Dispute
  disputedAt    DateTime?
  disputeReason String?
  resolvedAt    DateTime?

  // Ledger entries (double-entry)
  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([status, createdAt]) // For daily reconciliation
}

// Double-entry ledger for wallet/escrow integrity
model LedgerEntry {
  id String @id @default(uuid())

  escrowId String?
  escrow   EscrowTransaction? @relation(fields: [escrowId], references: [id])

  // Accounting
  accountType String // "ESCROW_HOLD", "PLATFORM_FEE", "PROFESSIONAL_PAYABLE", "TAX_WITHHELD"
  direction   String // "DEBIT" or "CREDIT"
  amount      Decimal @db.Decimal(12, 2)

  // Reference
  transactionRef String? // M-Pesa or Bank reference
  description    String

  // Audit
  createdAt DateTime @default(now())
  createdBy String // System or Admin ID

  @@index([escrowId, accountType])
}

// ========================================================
// CENTRALIZED ASSET MANAGEMENT (Deduplication)
// ========================================================

enum AssetVisibility {
  PUBLIC
  PRIVATE
}

model Asset {
  id String @id @default(uuid())

  // Ownership
  uploaderId String
  uploader   User   @relation("Uploader", fields: [uploaderId], references: [id])

  // File metadata
  originalName String
  mimeType     String
  size         Int
  checksum     String // SHA-256 for per-uploader deduplication

  // Storage (abstracted)
  bucket     String // e.g., "buildmarket-prod"
  key        String          @unique // S3/MinIO key
  cdnUrl     String?
  visibility AssetVisibility @default(PUBLIC)

  thumbnailUrl String? // Generated for images

  // Image metadata
  width    Int?
  height   Int?
  blurHash String? // For placeholder generation

  // Context (polymorphic association via join tables)
  projectImages        ProjectImage[]
  propertyDocs         PropertyDocument[]
  propertyAttachments  PropertyAttachment[]
  professionalDocs     ProfessionalDocument[] @relation("ProfessionalDocumentAssets")
  professionalLicenses ProfessionalLicense[]  @relation("ProfessionalLicenseAssets")
  storeDocs            StoreDocument[]
  projectDocs          ProjectDocument[]
  portfolioImages      PortfolioImage[]       @relation("PortfolioImageAssets")
  storeImages          StoreImage[]           @relation("StoreImageAssets")
  propertyImages       PropertyImage[]        @relation("PropertyImageAssets")
  messageAttachments   MessageAttachment[]
  products             Product[]              @relation("ProductImages")

  // Phase 1: New relations for standardized asset management
  quoteAttachments    QuoteAttachment[]    @relation("QuoteAttachmentAssets")
  reviewImages        ReviewImage[]        @relation("ReviewImageAssets")
  ideaBookAttachments IdeaBookAttachment[] @relation("IdeaBookAttachmentAssets")
  directUploads       DirectUpload[]

  // Usage tracking
  downloadCount Int       @default(0)
  lastAccessed  DateTime?

  createdAt DateTime @default(now())

  // Soft delete with grace period (24h cleanup job)
  deletedAt   DateTime?
  deleteAfter DateTime? // For temp uploads

  @@unique([uploaderId, checksum, visibility])
  @@index([uploaderId])
  @@index([checksum]) // Deduplication lookup
  @@index([createdAt])
}

enum DirectUploadStatus {
  PRESIGNED
  CONFIRMED
  EXPIRED
  FAILED
}

model DirectUpload {
  id String @id @default(uuid())

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  originalName String
  mimeType     String
  size         Int
  checksum     String

  bucket     String
  key        String          @unique
  visibility AssetVisibility @default(PRIVATE)

  status        DirectUploadStatus @default(PRESIGNED)
  expiresAt     DateTime
  confirmedAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  temporary   Boolean   @default(false)
  deleteAfter DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploaderId, status])
  @@index([expiresAt])
  @@index([checksum])
}

enum OnboardingUploadStatus {
  STAGED
  ATTACHED
  CONSUMED
  EXPIRED
  DELETED
  QUARANTINED
  SCAN_PENDING
  SCAN_FAILED
}

model OnboardingUpload {
  id               String                 @id @default(uuid())
  clerkId          String
  tempUrl          String
  originalName     String
  mimeType         String
  size             Int
  checksum         String
  storageBucket    String
  storageKey       String                 @unique
  status           OnboardingUploadStatus @default(STAGED)
  expiresAt        DateTime
  consumedAt       DateTime?
  consumedByUserId String?

  createdAt DateTime @default(now())

  @@unique([id, clerkId])
  @@index([clerkId])
  @@index([expiresAt])
}

// ========================================================
// 6. PORTFOLIOS (CASE STUDIES)
// ========================================================

model Portfolio {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)

  title       String
  slug        String      @unique
  description String?     @db.Text
  projectType ProjectType @default(RESIDENTIAL)
  tags        String[]

  location String?
  county   County?

  budget   Decimal? @db.Decimal(12, 2)
  currency String   @default("KES")

  durationValue  Int?
  durationUnit   ProjectDurationUnit @default(WEEKS)
  completionDate DateTime?

  linkedProjectId String?  @unique
  linkedProject   Project?
  isVerified      Boolean  @default(false)

  clientTestimonial String? @db.Text
  clientName        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images PortfolioImage[]

  @@index([professionalId])
  @@index([projectType])
}

model PortfolioImage {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  // OLD (deprecating)
  fileKey     String? @unique
  fileUrl     String?
  mimeType    String?
  size        Int?
  width       Int?
  height      Int?
  blurDataUrl String?

  assetId String?
  asset   Asset?  @relation("PortfolioImageAssets", fields: [assetId], references: [id], onDelete: Cascade)

  caption   String?
  category  PortfolioImageCategory @default(FINISHED_WORK)
  isMain    Boolean                @default(false)
  sortOrder Int                    @default(0)

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  savedInIdeaBooks SavedImage[]

  @@index([portfolioId])
  @@index([category])
}

// ========================================================
// 7. STORE & E-COMMERCE
// ========================================================

model Store {
  id             String              @id @default(uuid())
  version        Int?                @default(0) // Optimistic locking
  professionalId String
  professional   ProfessionalProfile @relation("ProfessionalStores", fields: [professionalId], references: [userId], onDelete: Cascade)

  name        String
  slug        String  @unique
  description String? @db.Text
  logoUrl     String?
  bannerUrl   String?

  contactPhone   String?
  whatsappNumber String?
  email          String?
  website        String?

  mpesaTillNumber String?
  mpesaPaybill    String?
  mpesaPasskey    String? // Encrypted
  acceptsCard     Boolean @default(false)
  acceptsCash     Boolean @default(true)

  address      String
  city         String
  county       County?
  neighborhood String?
  zipCode      String?
  coordinates  Json?   @db.JsonB
  latitude     Float?
  longitude    Float?

  storeType        StoreType       @default(RETAIL)
  categories       StoreCategory[]
  storeEvents      StoreEvent[]
  deliveryOption   DeliveryOption  @default(PICKUP_ONLY)
  deliveryRadiusKm Int?
  baseDeliveryFee  Decimal?        @default(0) @db.Decimal(10, 2)
  minOrderValue    Decimal?        @default(0) @db.Decimal(10, 2)
  operatingHours   Json?           @db.JsonB
  isOpen           Boolean         @default(true)

  idempotencyKeys IdempotencyKey[]

  businessRegNo      String?
  kraPin             String?
  verified           Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?              @relation("StoreVerifier", fields: [verifiedById], references: [id])
  rejectionReason    String?

  featured    Boolean @default(false)
  rating      Decimal @default(0.0) @db.Decimal(3, 2)
  reviewCount Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  deletedAt   DateTime?

  images    StoreImage[]
  documents StoreDocument[]
  products  Product[]
  orders    Order[]         @relation("StoreOrders")
  reviews   Review[]        @relation("StoreReviews")

  @@index([professionalId, deletedAt])
  @@index([version])
  @@index([verified])
  @@index([storeType])
  @@index([county])
}

model StoreEvent {
  id        String         @id @default(uuid())
  storeId   String
  type      StoreEventType
  payload   Json           @db.JsonB
  metadata  Json?          @db.JsonB
  version   Int // Event version (sequential)
  createdAt DateTime       @default(now())
  createdBy String

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, version])
  @@index([createdAt])
}

enum StoreEventType {
  STORE_CREATED
  STORE_UPDATED
  STORE_DELETED
  STORE_RESTORED
  IMAGES_UPDATED
  OWNERSHIP_TRANSFERRED
}

model StoreDocument {
  id      String            @id @default(uuid())
  storeId String
  store   Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type    StoreDocumentType

  // OLD (deprecating)
  fileKey  String? @unique
  fileUrl  String?
  mimeType String?
  size     Int?

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Additional logging for sensitive data access
  accessLog Json? // [{userId: "admin123", action: "VIEW", at: "2026-01-..."}]

  status          DocumentStatus @default(PENDING)
  verified        Boolean        @default(false)
  verifiedAt      DateTime?
  rejectionReason String?
  issueDate       DateTime?
  expiryDate      DateTime?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
  @@index([status])
}

model StoreImage {
  id      String @id @default(uuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // OLD (deprecating)
  fileKey     String? @unique
  fileUrl     String?
  mimeType    String?
  size        Int?
  width       Int?
  height      Int?
  blurDataUrl String?

  assetId String?
  asset   Asset?  @relation("StoreImageAssets", fields: [assetId], references: [id], onDelete: Cascade)

  // Additional logging for sensitive data access
  accessLog Json? // [{userId: "admin123", action: "VIEW", at: "2026-01-..."}]

  category  StoreImageCategory @default(INTERIOR)
  caption   String?
  isMain    Boolean            @default(false)
  sortOrder Int                @default(0)

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([storeId])
}

model Product {
  id String @id @default(uuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  sku         String?
  description String? @db.Text

  // Pricing
  price     Decimal  @db.Decimal(12, 2)
  compareAt Decimal? @db.Decimal(12, 2) // "Was" price
  costPrice Decimal? @db.Decimal(12, 2) // For analytics

  // Inventory
  stockQuantity  Int     @default(0)
  lowStockAlert  Int     @default(5)
  trackInventory Boolean @default(true)

  // Categorization
  category   StoreCategory
  tags       String[]
  attributes Json?         @db.JsonB // {color: "red", size: "2x4"}

  // Media
  images Asset[] @relation("ProductImages")

  // SEO
  metaTitle       String?
  metaDescription String?

  // Status
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orderItems    OrderItem[]
  reviews       Review[]       @relation("ProductReviews")
  savedProducts SavedProduct[]

  @@unique([storeId, slug])
  @@index([storeId, category])
  @@index([isActive, isFeatured])
  @@index([name, description]) // PostgreSQL FTS index
}

model Order {
  id             String               @id @default(uuid())
  clientId       String
  client         User                 @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)
  storeId        String?
  store          Store?               @relation("StoreOrders", fields: [storeId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   ProfessionalProfile? @relation("ProfessionalOrders", fields: [professionalId], references: [userId], onDelete: SetNull)

  items         OrderItem[]
  totalAmount   Decimal     @db.Decimal(12, 2)
  status        OrderStatus @default(PENDING)
  paymentMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  reviews  Review[]

  @@index([clientId, status, createdAt]) // Client order history
  @@index([storeId, status]) // Store order management
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name             String
  price            Decimal  @db.Decimal(12, 2)
  quantity         Int
  snapshotImageUrl String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  transactionId String        @unique
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  @@index([orderId])
  @@index([transactionId])
}

// ========================================================
// 8. REAL ESTATE (PROPERTIES)
// ========================================================

model Property {
  id          String           @id @default(uuid())
  title       String
  slug        String           @unique
  version     Int              @default(0)
  description String?          @db.Text
  type        PropertyType
  category    PropertyCategory

  price           Decimal  @db.Decimal(12, 2)
  currency        String   @default("KES")
  priceNegotiable Boolean  @default(false)
  serviceCharge   Decimal? @default(0) @db.Decimal(10, 2)
  depositRequired String?
  paymentTerms    String?

  tenure              PropertyTenure? @default(FREEHOLD)
  leaseYearsRemaining Int?
  titleDeedNumber     String?         @unique
  titleDeedReady      Boolean         @default(false)

  bedrooms         Int?
  bathrooms        Int?
  parkingSpaces    Int?
  buildingSize     Float?
  plotSize         Float?
  areaUnit         AreaUnit         @default(SQ_METERS)
  yearBuilt        Int?
  furnishing       FurnishingStatus @default(UNFURNISHED)
  completionStatus CompletionStatus @default(READY_TO_MOVE)

  location        String
  address         String?
  county          County?
  constituency    String?
  neighbourhood   String?
  coordinates     Json?   @db.JsonB
  latitude        Float?
  longitude       Float?
  nearbyLandmarks Json?   @db.JsonB

  hasBorehole        Boolean  @default(false)
  hasBackupGenerator Boolean  @default(false)
  hasElevator        Boolean  @default(false)
  hasCCTV            Boolean  @default(false)
  isGatedCommunity   Boolean  @default(false)
  features           String[]

  status   PropertyStatus @default(AVAILABLE)
  featured Boolean        @default(false)

  verified           Boolean            @default(false)
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?              @relation("PropertyVerifier", fields: [verifiedById], references: [id])
  submittedAt        DateTime?
  rejectionReason    String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?

  viewCount    Int @default(0)
  inquiryCount Int @default(0)

  agentId String
  agent   ProfessionalProfile @relation("AgentProperties", fields: [agentId], references: [userId], onDelete: Restrict)

  images          PropertyImage[]
  attachments     PropertyAttachment[]
  documents       PropertyDocument[]
  inquiries       PropertyInquiry[]
  idempotencyKeys IdempotencyKey[]

  floorPlanUrl   String?
  videoUrl       String?
  virtualTourUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([title, description]) // PostgreSQL FTS index
  @@index([agentId, status])
  @@index([county, status, price])
  @@index([featured, createdAt])
  @@index([type, category, county, status]) // Full search filter
  @@index([category, status, featured]) // Featured listings by category
}

model PropertyDocument {
  id         String               @id @default(uuid())
  propertyId String
  property   Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       PropertyDocumentType
  notes      String?

  // OLD (deprecating)
  fileKey  String? @unique
  url      String?
  mimeType String?
  size     Int?

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Additional logging for sensitive data access
  accessLog Json? // [{userId: "admin123", action: "VIEW", at: "2026-01-..."}]

  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedById    String?
  issueDate       DateTime?
  expiryDate      DateTime?
  isPrivate       Boolean        @default(true)

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // OLD (deprecating)
  fileKey     String? @unique
  url         String?
  mimeType    String?
  size        Int?
  width       Int?
  height      Int?
  blurDataUrl String?

  assetId String?
  asset   Asset?  @relation("PropertyImageAssets", fields: [assetId], references: [id], onDelete: Cascade)

  // Additional logging for sensitive data access
  accessLog Json? // [{userId: "admin123", action: "VIEW", at: "2026-01-..."}]

  caption   String?
  category  ImageCategory @default(EXTERIOR)
  tags      String[]
  isMain    Boolean       @default(false)
  sortOrder Int           @default(0)

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([propertyId])
  @@index([category])
}

model PropertyAttachment {
  id         String         @id @default(uuid())
  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title      String
  type       AttachmentType

  // OLD (deprecating)
  fileKey  String? @unique
  fileUrl  String?
  mimeType String?
  size     Int?

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  notes String?

  // Additional logging for sensitive data access
  accessLog Json? // [{userId: "admin123", action: "VIEW", at: "2026-01-..."}]

  downloadCount Int      @default(0)
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId])
}

model PropertyInquiry {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  senderId String?
  sender   User?   @relation("InquirySender", fields: [senderId], references: [id], onDelete: SetNull)

  name      String?
  email     String?
  phone     String?
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

// ========================================================
// 9. FINANCIALS & QUOTES
// ========================================================

model Quote {
  id             String              @id @default(uuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  clientId       String
  client         ClientProfile       @relation(fields: [clientId], references: [userId], onDelete: Cascade)

  version         Int     @default(1)
  isLatest        Boolean @default(true)
  previousQuoteId String?

  materialsTotal Decimal @default(0) @db.Decimal(12, 2)
  laborTotal     Decimal @default(0) @db.Decimal(12, 2)
  logisticsTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  currency       String  @default("KES")

  title             String
  description       String?  @db.Text
  validUntil        DateTime
  paymentTerms      String?  @db.Text
  estimatedDuration Int?

  status          QuoteStatus @default(DRAFT)
  viewedAt        DateTime?
  respondedAt     DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       QuoteItem[]
  attachments QuoteAttachment[]

  @@index([projectId])
  @@index([status])
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit        String
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  category    String?
  sortOrder   Int     @default(0)

  @@index([quoteId])
}

model QuoteAttachment {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  title   String

  // OLD (deprecating - migrate to Asset)
  fileKey  String? @unique
  fileUrl  String?
  mimeType String?
  size     Int?

  // NEW: Centralized asset reference
  assetId String?
  asset   Asset?  @relation("QuoteAttachmentAssets", fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([quoteId])
}

model ProfessionalTransaction {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  leadId         String?
  subscriptionId String?

  description String
  type        TransactionType
  category    TransactionCategory @default(PROJECT_PAYMENT)
  method      PaymentMethod       @default(MPESA)

  amount      Decimal @db.Decimal(12, 2)
  platformFee Decimal @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  netAmount   Decimal @default(0) @db.Decimal(12, 2)
  currency    String  @default("KES")

  referenceCode    String? @unique
  providerMetadata Json?   @db.JsonB

  status       TransactionStatus @default(PENDING)
  failedReason String?
  date         DateTime          @default(now())
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([professionalId])
  @@index([referenceCode])
}

// ========================================================
// 10. CRM & CALENDAR
// ========================================================

model Lead {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  clientId       String?
  client         User?               @relation(fields: [clientId], references: [id], onDelete: SetNull)

  clientName  String
  clientEmail String?
  clientPhone String?
  title       String
  description String?     @db.Text
  projectType ProjectType @default(RESIDENTIAL)

  location String?
  county   County?

  budget    Decimal? @db.Decimal(12, 2)
  budgetMin Decimal? @db.Decimal(12, 2)
  budgetMax Decimal? @db.Decimal(12, 2)
  currency  String   @default("KES")

  status     LeadStatus   @default(NEW)
  priority   LeadPriority @default(MEDIUM)
  source     LeadSource   @default(PLATFORM_SEARCH)
  lostReason LostReason?
  wonAt      DateTime?

  notes           String?   @db.Text
  lastContactedAt DateTime?
  followUpDate    DateTime?
  reminderSent    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId])
  @@index([status])
  @@index([county])
  @@index([professionalId, status, priority]) // CRM pipeline view
  @@index([status, createdAt]) // Lead aging reports
}

// ========================================================
// 10B. MARKETPLACE PRE-QUALIFIED LEADS
// ========================================================

model MarketplaceLead {
  id            String                @id @default(cuid())
  clientId      String
  client        User                  @relation("ClientMarketplaceLeads", fields: [clientId], references: [id], onDelete: Cascade)
  status        MarketplaceLeadStatus @default(DRAFT)
  projectCounty String
  projectType   String
  title         String?
  description   String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  qualification MarketplaceLeadQualification?
  documents     MarketplaceLeadDocument[]
  routingEvents MarketplaceLeadRoutingEvent[]

  @@index([clientId])
  @@index([status, projectCounty])
  @@index([createdAt])
}

model MarketplaceLeadQualification {
  id                  String                          @id @default(cuid())
  leadId              String                          @unique
  lead                MarketplaceLead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)

  landOwnershipStatus MarketplaceLandOwnershipStatus?
  architecturalStage  MarketplaceArchitecturalStage?
  budgetReadiness     MarketplaceBudgetReadiness?
  budgetRangeMin      Int?
  budgetRangeMax      Int?

  confidenceScore     Float?
  confidenceLabel     String?                         // "high" | "medium" | "low"
  scoringRuleVersion  String?                         // e.g. "leads-v3"
  breakdownJson       Json?                           @db.JsonB
  scoredAt            DateTime?
  reviewedBy          String?                         // staff userId, if manually reviewed
  reviewNotes         String?

  updatedAt           DateTime                        @updatedAt
}

model MarketplaceLeadDocument {
  id         String                      @id @default(cuid())
  leadId     String
  lead       MarketplaceLead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       MarketplaceLeadDocumentType
  fileKey    String
  scanStatus String                      @default("pending") // pending | clean | infected | failed
  scannedAt  DateTime?
  createdAt  DateTime                    @default(now())

  @@index([leadId])
  @@index([scanStatus])
}

model MarketplaceLeadRoutingEvent {
  id                 String              @id @default(cuid())
  leadId             String
  lead               MarketplaceLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  professionalId     String
  professional       ProfessionalProfile @relation("ProfessionalMarketplaceRouting", fields: [professionalId], references: [userId], onDelete: Cascade)
  matchScore         Float
  confidenceLabel    String              // "high" | "medium" | "low"
  routedAt           DateTime            @default(now())
  outcome            String?             // accepted | declined | expired | won | lost
  outcomeAt          DateTime?
  contactDisclosedAt DateTime?

  @@index([professionalId, routedAt])
  @@index([leadId])
}

model CalendarEvent {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  clientId       String?
  client         User?               @relation("ClientCalendarEvents", fields: [clientId], references: [id], onDelete: SetNull)
  guestEmails    String[]

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title       String
  description String?             @db.Text
  type        CalendarEventType   @default(MEETING)
  status      CalendarEventStatus @default(SCHEDULED)

  startDate      DateTime
  endDate        DateTime
  isAllDay       Boolean  @default(false)
  timeZone       String   @default("Africa/Nairobi")
  recurrenceRule String?

  location   String?
  meetingUrl String?
  reminders  Int[]   @default([30])

  externalEventId String? @unique
  color           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId])
  @@index([startDate])
}

// ========================================================
// 11. COMMUNICATION & IDEAS
// ========================================================

model MessageThread {
  id            String     @id @default(uuid())
  type          ThreadType @default(DIRECT)
  subject       String?
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lastMessage   String?    @db.Text
  lastMessageAt DateTime?
  metadata      Json?      @db.JsonB

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  isArchived Boolean @default(false)

  participants ThreadParticipant[]
  messages     Message[]
  // Note: Index on participants removed (cannot index relation fields)

  @@index([lastMessageAt])
}

model ThreadParticipant {
  id       String        @id @default(uuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String

  nickname String?
  role     ParticipantRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  unreadCount Int       @default(0)
  lastReadAt  DateTime?
  isMuted     Boolean   @default(false)
  isArchived  Boolean   @default(false)
  isPinned    Boolean   @default(false)

  @@unique([threadId, userId])
  @@index([userId, unreadCount])
}

model Message {
  id       String        @id @default(uuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String

  content String      @db.Text
  type    MessageType @default(TEXT)

  replyToId String?
  replyTo   Message? @relation("ReplyHistory", fields: [replyToId], references: [id], onDelete: SetNull)

  reactions    MessageReaction[]
  replies      Message[]         @relation("ReplyHistory")
  readReceipts ReadReceipt[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  attachments MessageAttachment[]

  @@index([threadId, createdAt])
}

model MessageReaction {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model ReadReceipt {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String

  readAt DateTime @default(now())

  @@unique([messageId, userId])
