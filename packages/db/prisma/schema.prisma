// ========================================================
// 13. M-PESA INTEGRATION (PRODUCTION HARDENED)
// ========================================================

model MpesaTransaction {
  id String @id @default(uuid())

  // Request tracking (idempotency)
  merchantRequestId String? @unique // From STK push
  checkoutRequestId String? @unique // From STK push
  idempotencyKey    String  @unique

  // Context
  userId          String
  projectId       String?
  escrowId        String?
  transactionType MpesaTransactionType

  // Financials
  amount      Decimal @db.Decimal(10, 2)
  phoneNumber String // 2547XX...

  // Status flow
  status             TransactionStatus @default(PENDING)
  resultCode         String? // M-Pesa result code
  resultDesc         String? // M-Pesa description
  mpesaReceiptNumber String? // Official receipt
  transactionDate    DateTime?

  // Callback tracking
  callbackReceivedAt DateTime?
  callbackPayload    Json?

  // Reversal handling
  reversalTransactionId String?
  isReversed            Boolean @default(false)

  // Retries (for failed pushes)
  retryCount  Int       @default(0)
  nextRetryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([checkoutRequestId])
  @@index([mpesaReceiptNumber])
  @@index([status, createdAt]) // Reconciliation queries
  @@index([nextRetryAt]) // Retry job queue
}

// Cold storage archive for settled M-Pesa transactions (>180 days)
model MpesaTransactionArchive {
  id String @default(uuid())

  // Request tracking (idempotency snapshot)
  merchantRequestId String?
  checkoutRequestId String?
  idempotencyKey    String

  // Context
  userId          String
  projectId       String?
  escrowId        String?
  transactionType MpesaTransactionType

  // Financials
  amount      Decimal @db.Decimal(10, 2)
  phoneNumber String

  // Status flow
  status             TransactionStatus
  resultCode         String?
  resultDesc         String?
  mpesaReceiptNumber String?
  transactionDate    DateTime?

  // Callback tracking
  callbackReceivedAt DateTime?
  callbackPayload    Json?

  // Reversal handling
  reversalTransactionId String?
  isReversed            Boolean @default(false)

  // Retries
  retryCount  Int       @default(0)
  nextRetryAt DateTime?

  createdAt  DateTime
  updatedAt  DateTime
  archivedAt DateTime @default(now())

  @@id([id, archivedAt])
  @@index([userId, status, archivedAt])
  @@index([checkoutRequestId, archivedAt])
  @@index([mpesaReceiptNumber, archivedAt])
  @@index([archivedAt])
}

