generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  client
  professional
  admin
}

enum ProjectStatus {
  planning
  in_progress
  completed
  archived
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
  cancelled
}

enum ReviewType {
  professional
  store
}

enum PaymentStatus {
  success
  failed
  refunded
  pending
}

enum MessageType {
  text
  image
  file
  pdf
  system
}

enum CertificateVerificationStatus {
  pending
  verified
  rejected
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL
  WON
  LOST
}

enum TransactionType {
  INCOME
  WITHDRAWAL
  EXPENSE
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  CANCELLED
}

enum PropertyType {
  SALE
  RENT
  LEASE
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  LAND
  INDUSTRIAL
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RENTED
  UNDER_OFFER
}

enum StoreCategory {
  hardware // Tools, fasteners, nails, screws
  building_materials // Cement, sand, bricks, blocks
  tiles_and_ceramics // Floor tiles, wall tiles, mosaics
  electrical // Cables, switches, lighting
  plumbing // Pipes, fittings, sanitaryware
  paints_and_finishes // Paints, varnishes, coatings
  roofing // Metal sheets, tiles, gutters
  timber_and_wood // Lumber, plywood, doors
  glass_and_aluminum // Windows, mirrors, aluminum profiles
  kitchen_and_bath // Cabinets, sinks, fixtures
  landscaping // Pavers, outdoor materials
  steel_and_metals // Reinforcement bars, structural steel
  safety_and_tools // PPE, power tools, hand tools
  hvac // Air conditioning, ventilation
}

enum StoreType {
  retail // Direct consumer sales
  wholesale // Bulk/trade sales
  manufacturer // Factory/producer
  distributor // Official distributor
  online_only // E-commerce only
}

enum County {
  BARINGO
  BOMET
  BUNGOMA
  BUSIA
  ELGEYO_MARAKWET
  EMBU
  GARISSA
  HOMA_BAY
  ISIOLO
  KAJIADO
  KAKAMEGA
  KERICHO
  KIAMBU
  KILIFI
  KIRINYAGA
  KISII
  KISUMU
  KITUI
  KWALE
  LAIKIPIA
  LAMU
  MACHAKOS
  MAKUENI
  MANDERA
  MARSABIT
  MERU
  MIGORI
  MOMBASA
  MURANGA
  NAIROBI
  NAKURU
  NANDI
  NAROK
  NYAMIRA
  NYANDARUA
  NYERI
  SAMBURU
  SIAYA
  TAITA_TAVETA
  TANA_RIVER
  THARAKA_NITHI
  TRANS_NZOIA
  TURKANA
  UASIN_GISHU
  VIHIGA
  WAJIR
  WEST_POKOT
}

enum Profession {
  GENERAL_CONTRACTOR
  ELECTRICIAN
  PLUMBER
  CARPENTER
  MASON
  INTERIOR_DESIGNER
  ARCHITECT
  LANDSCAPER
  PAINTER
  HVAC_TECHNICIAN
  ROOFER
  GLAZIER
  WELDER
  OTHER
}

model ServiceCategory {
  id             String      @id @default(uuid())
  name           String
  slug           String      @unique
  description    String?
  icon           String?
  professionType Profession?
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)

  // Relations
  professionals ProfessionalProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  isMain     Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model PropertyAttachment {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fileUrl    String
  type       String // e.g. "title_deed", "floor_plan"
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model Service {
  id            String                @id @default(uuid())
  name          String
  slug          String                @unique
  icon          String?
  professionals ProfessionalProfile[] // Implicit many-to-many relation
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Property {
  id          String           @id @default(uuid())
  title       String
  description String?
  price       Decimal          @db.Decimal(12, 2)
  currency    String           @default("KES")
  type        PropertyType // SALE, RENT, LEASE
  category    PropertyCategory

  // Location
  location      String // e.g. "Kilimani, Nairobi"
  address       String?
  county        County?
  constituency  String?
  neighbourhood String?
  coordinates   Json?
  latitude      Float?
  longitude     Float?

  // Details
  bedrooms      Int?
  bathrooms     Int?
  areaSqFt      Float?
  lotSize       Float? // For land
  parkingSpaces Int?
  yearBuilt     Int?

  // Media
  images      PropertyImage[]
  attachments PropertyAttachment[]
  floorPlan   String?
  videoUrl    String?

  // Meta
  features String[] // ["Swimming Pool", "Gym", "Borehole"]
  status   PropertyStatus @default(AVAILABLE)
  featured Boolean        @default(false)

  // Verification
  verified           Boolean            @default(false)
  verifiedAt         DateTime?
  rejectionReason    String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?

  // Relations
  agentId String
  agent   ProfessionalProfile @relation(fields: [agentId], references: [userId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([location])
  @@index([price])
  @@index([agentId])
  @@index([verified])
  @@index([county])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model User {
  id                   String               @id @default(uuid())
  clerkId              String               @unique
  email                String               @unique
  firstName            String?
  lastName             String?
  phone                String?
  avatar               String?
  role                 UserRole             @default(client)
  isProfileComplete    Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  clientProfile        ClientProfile?
  professionalProfile  ProfessionalProfile?
  adminProfile         AdminProfile?
  projects             Project[]            @relation("ClientProjects")
  orders               Order[]              @relation("ClientOrders")
  reviews              Review[]             @relation("Reviewer")
  ideaBooks            IdeaBook[]           @relation("IdeaBookOwner")
  sharedIdeaBooks      IdeaBook[]           @relation("IdeaBookShares")
  messageThreads       MessageThread[]      @relation("MessageThreadUsers")
  messages             Message[]            @relation("Sender")
  analytics            UserAnalytics[]
  verifiedCertificates Certificate[]        @relation("CertificateVerifier")
  calendarEvents       CalendarEvent[]
  notifications        Notification[]
  adminAuditLogs       AdminAuditLog[]

  @@index([clerkId])
  @@index([email])
  @@index([role])
}

model SystemSettings {
  id               String   @id @default("global")
  maintenanceMode  Boolean  @default(false)
  publicSignup     Boolean  @default(true)
  autoVerifyNCA    Boolean  @default(false)
  commissionRate   Decimal  @default(10.0) @db.Decimal(5, 2)
  supportEmail     String   @default("support@buildmarket.co.ke")
  adminEmailAlerts Boolean  @default(true)
  securityMFA      Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model ClientProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     String?
  city        String?
  county      String?
  zipCode     String?
  preferences Json?
  quotes      Quote[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProfessionalProfile {
  userId             String                    @id
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  profession         String?
  licenseNumber      String?                   @unique
  yearsExperience    Int?
  servicesOffered    String[]
  services           ServiceCategory[]
  images             String[]
  portfolioUrl       String?
  website            String?
  bio                String?
  city               String?
  county             String?
  country            String?
  verified           Boolean                   @default(false)
  verificationStatus VerificationStatus        @default(PENDING)
  verificationNotes  String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  portfolios         Portfolio[]
  stores             Store[]                   @relation("ProfessionalStores")
  projects           Project[]                 @relation("ProfessionalProjects")
  orders             Order[]                   @relation("ProfessionalOrders")
  reviews            Review[]                  @relation("ProfessionalReviews")
  certificates       Certificate[]
  calendarEvents     CalendarEvent[]
  leads              Lead[]
  transactions       ProfessionalTransaction[]
  quotes             Quote[]
  properties         Property[]
  service            Service?                  @relation(fields: [serviceId], references: [id])
  serviceId          String?

  @@index([verified])
  @@index([city])
  @@index([county])
  @@index([companyName])
}

model AdminProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[]
}

model Project {
  id                       String                    @id @default(uuid())
  clientId                 String
  client                   User                      @relation(fields: [clientId], references: [id], onDelete: Cascade, name: "ClientProjects")
  professionalId           String?                   @map("professionalId")
  professional             ProfessionalProfile?      @relation(fields: [professionalId], references: [userId], onDelete: SetNull, name: "ProfessionalProjects")
  professionalTransactions ProfessionalTransaction[]
  title                    String
  description              String?
  status                   ProjectStatus             @default(planning)
  budget                   Decimal?                  @db.Decimal(10, 2)
  startDate                DateTime?
  endDate                  DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  milestones               ProjectMilestone[]
  messageThreads           MessageThread[]
  calendarEvents           CalendarEvent[]
  reviews                  Review[]
  quotes                   Quote[]

  @@index([clientId])
  @@index([professionalId])
  @@index([status])
  @@index([createdAt])
}

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model IdeaBook {
  id          String               @id @default(uuid())
  clientId    String
  client      User                 @relation(fields: [clientId], references: [id], onDelete: Cascade, name: "IdeaBookOwner")
  title       String
  description String?
  items       Json // Stores IdeaBookItem array as JSONB
  sharedWith  User[]               @relation("IdeaBookShares")
  attachments IdeaBookAttachment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([clientId])
  @@index([createdAt])
}

model IdeaBookAttachment {
  id         String   @id @default(uuid())
  ideaBookId String
  ideaBook   IdeaBook @relation(fields: [ideaBookId], references: [id], onDelete: Cascade)
  url        String // URL to the uploaded file
  filename   String // Original filename
  size       Int // File size in bytes
  mimeType   String // e.g., "image/jpeg", "image/png"
  caption    String? // Optional caption/description for the image
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ideaBookId])
  @@index([createdAt])
}

model Review {
  id             String               @id @default(uuid())
  reviewerId     String
  reviewer       User                 @relation(fields: [reviewerId], references: [id], onDelete: Cascade, name: "Reviewer")
  professionalId String?
  storeId        String?
  professional   ProfessionalProfile? @relation(fields: [professionalId], references: [userId], onDelete: Cascade, name: "ProfessionalReviews")
  store          Store?               @relation(fields: [storeId], references: [id], onDelete: Cascade, name: "StoreReviews")
  projectId      String?
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type           ReviewType
  rating         Int // 1-5 rating scale
  comment        String?
  approved       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([type])
  @@index([rating])
  @@index([approved])
  @@index([professionalId])
  @@index([storeId])
  @@index([projectId])
}

model Store {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade, name: "ProfessionalStores")
  name           String
  slug           String              @unique // Added
  description    String?
  address        String
  city           String
  county         County?             // Ensure this uses the County enum
  zipCode        String?
  
  images         StoreImage[]
  
  categories     StoreCategory[]
  storeType      StoreType           @default(retail)
  
  // Verification
  verified            Boolean             @default(false)
  verificationStatus  VerificationStatus  @default(PENDING)
  verificationNotes   String?
  verifiedAt          DateTime?           // Added
  rejectionReason     String?             // Added
  
  featured       Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  products       Product[]
  orders         Order[]             @relation("StoreOrders")
  reviews        Review[]            @relation("StoreReviews")

  @@index([professionalId])
  @@index([verified])
  @@index([storeType])
  @@index([county])
}

model StoreImage {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([storeId])
}

model Product {
  id          String      @id @default(uuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  category    String
  inStock     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id             String               @id @default(uuid())
  clientId       String
  client         User                 @relation(fields: [clientId], references: [id], onDelete: Cascade, name: "ClientOrders")
  storeId        String?
  store          Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull, name: "StoreOrders")
  professionalId String?
  professional   ProfessionalProfile? @relation(fields: [professionalId], references: [userId], onDelete: SetNull, name: "ProfessionalOrders")
  items          OrderItem[]
  totalAmount    Decimal              @db.Decimal(10, 2)
  status         OrderStatus          @default(pending)
  paymentMethod  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  payments       Payment[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String // Snapshot of product name
  price     Decimal  @db.Decimal(10, 2) // Snapshot of product price
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  transactionId String        @unique
  status        PaymentStatus @default(pending)
  createdAt     DateTime      @default(now())

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
}

model Portfolio {
  id                String              @id @default(uuid())
  professionalId    String
  professional      ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  title             String
  description       String?
  images            String[]
  projectType       String
  clientTestimonial String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model MessageThread {
  id            String    @id @default(uuid())
  users         User[]    @relation("MessageThreadUsers")
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lastMessage   String?
  lastMessageAt DateTime?
  unreadCount   Json? // Map of userId -> unread count
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]

  @@index([lastMessageAt])
}

model Message {
  id          String        @id @default(uuid())
  threadId    String
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id], name: "Sender")
  content     String // Encrypted in messaging-service
  type        MessageType   @default(text)
  readBy      String[]      @default([]) // UUIDs of users
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  attachments Attachment[]

  @@index([threadId, createdAt])
  @@index([senderId])
  @@index([createdAt])
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String // Encrypted in messaging-service
  filename  String // Encrypted in messaging-service
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  @@index([messageId])
}

model UserAnalytics {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics  Json // Stores AnalyticsMetric array as JSONB
  fromDate DateTime
  toDate   DateTime
}

model Certificate {
  id                 String                        @id @default(uuid())
  professionalId     String
  professional       ProfessionalProfile           @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  name               String
  issuer             String
  issueDate          DateTime?
  expiryDate         DateTime?
  fileUrl            String
  verificationStatus CertificateVerificationStatus @default(pending)
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?                         @relation(fields: [verifiedById], references: [id], onDelete: SetNull, name: "CertificateVerifier")
  notes              String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@index([professionalId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([verificationStatus])
  @@index([verifiedById])
}

model CalendarEvent {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime
  location       String?
  type           String              @default("meeting") // meeting, site_visit, deadline, etc.
  status         String              @default("scheduled") // scheduled, completed, cancelled
  clientId       String?
  client         User?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([professionalId])
  @@index([startDate])
}

model Lead {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  clientName     String
  clientEmail    String?
  clientPhone    String?
  projectType    String
  location       String?
  budget         String?
  status         LeadStatus          @default(NEW)
  notes          String?
  source         String?
  followUpDate   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([professionalId])
  @@index([status])
}

model ProfessionalTransaction {
  id             String              @id @default(uuid())
  professionalId String
  projectId      String?
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  description    String
  amount         Decimal             @db.Decimal(10, 2)
  type           TransactionType
  status         TransactionStatus   @default(PENDING)
  date           DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([professionalId])
  @@index([date])
  @@index([projectId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Quote {
  id             String              @id @default(uuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  professionalId String
  clientId       String
  client         ClientProfile       @relation(fields: [clientId], references: [userId], onDelete: Cascade)
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [userId], onDelete: Cascade)
  amount         Decimal             @db.Decimal(10, 2)
  description    String?
  status         String              @default("pending") // pending, accepted, rejected
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([projectId])
  @@index([professionalId])
  @@index([clientId])
}
