  entityType String // "User", "Project", "Payment"
  entityId   String

  // Context
  changes  Json? // { old: {email: "a@b.c"}, new: {email: null} }
  metadata Json? // { ip: "102.68.x.x", userAgent: "...", location: "Nairobi" }

  // GDPR Specific
