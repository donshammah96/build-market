// --------------------------------------------------------
// BUILD MARKET SCHEMA - PRODUCTION READY (v2.0)
// Optimized for: Kenya Construction Industry, M-Pesa, & SEO
// --------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "mysql"
  url      = env("DATABASE_URL")
}

