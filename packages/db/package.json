{
  "name": "@build/db",
  "version": "1.0.0",
  "description": "BuildMarket Database",
  "type": "module",
  "main": "./dist/lib/prisma.js",
  "types": "./dist/lib/prisma.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/prisma.d.ts",
      "import": "./dist/lib/prisma.js",
      "default": "./dist/lib/prisma.js"
    },
    "./system-settings": {
      "types": "./dist/lib/system-settings.d.ts",
      "import": "./dist/lib/system-settings.js",
      "default": "./dist/lib/system-settings.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); try { require('fs').unlinkSync('tsconfig.tsbuildinfo'); } catch(e) {}\"",
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "prepack": "pnpm run build",
    "check-types": "tsc --noEmit",
    "lint": "echo \"No lint configured\" && exit 0",
    "test": "echo \"No tests configured\" && exit 0",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "Don Shammah",
  "license": "ISC",
  "dependencies": {
    "@build/types": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "pg": "catalog:",
    "prisma": "catalog:",
    "zod": "catalog:"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/config": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}