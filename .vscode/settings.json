{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.useWorkspaceTsdk": true,
  "json.schemaDownload.enable": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.workingDirectories": [
    { "pattern": "apps/*/" },
    { "pattern": "packages/*/" }
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/build": true,
    "**/.vercel": true,
    "**/coverage/**": true,
    "**/.git/**": true,
    "**/*.js.map": true,
    "**/playwright-report/**": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/dist/**": true,
    "**/.vercel/**": true,
    "**/coverage/**": true,
    "**/.git/**": true,
    "**/*.js.map": true,
    "**/playwright-report/**": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/dist": true,
    "**/.vercel": true,
    "**/coverage": true
  },
  "chat.tools.terminal.autoApprove": {
    "pnpm": true,
    "Push-Location": true,
    "Pop-Location": true,
    "/^Copy-Item -Path \\.\\/.*-Destination \\.\\//": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^Set-Content -Path \\.\\//": {
      "approve": true,
      "matchCommandLine": true
    },
    "pnpm test:projects-api:json": true,
    "pnpm test:projects-api": true,
    "pnpm test:portfolio-api": true,
    "pnpm test:secure-action": true,
    "pnpm test:stores-route": true,
    "pnpm test:projects-property-focused": true,
    "pnpm test:browser-hook-sweep": true,
    "pnpm test:dashboard-hook": true,
    "pnpm test:dashboard-browser-clients": true,
    "pnpm test:properties-risk": true,
    "pnpm test:projects-envelope-focused": true,
    "pnpm test:properties-service-once": true,
    "pnpm test:button-slot-regression": true,
    "pnpm test:button-slot-regression:single-worker": true,
    "pnpm test:onboarding-ui-a11y:single-worker": true,
    "/^Start-Process .* -NoNewWindow/": {
      "approve": true,
      "matchCommandLine": true
    },
    "pnpm test:leads": true,
    "/^Push-Location apps/client; node node_modules/typescript.*/": {
      "approve": true,
      "matchCommandLine": true
    },
    ".\\scripts\\invoke-clean.ps1": true,
    "/^cmd /d /s /c \"set REDIS_FAMILY=4 && pnpm run redis:healthcheck\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^cmd /c \"pnpm -C apps/client exec vitest run __tests__/api/properties/property-id\\.route\\.test\\.ts __tests__/api/stores/store-id\\.route\\.test\\.ts __tests__/api/messaging/route-auth-mapping\\.test\\.ts --maxWorkers=1 --coverage --coverage\\.reporter=json-summary --coverage\\.reportsDirectory=tmp/coverage-trio7 --coverage\\.thresholds\\.statements=0 --coverage\\.thresholds\\.branches=0 --coverage\\.thresholds\\.functions=0 --coverage\\.thresholds\\.lines=0\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^cmd /c \"pnpm -C apps/client exec vitest run __tests__/api/professional-portal/documents\\.route\\.test\\.ts __tests__/api/professional-portal/certificates\\.route\\.test\\.ts __tests__/api/professional-portal/licenses\\.route\\.test\\.ts --maxWorkers=1\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^cmd /c \"pnpm -C apps/client exec vitest run __tests__/api/properties/property-id\\.route\\.test\\.ts __tests__/api/stores/store-id\\.route\\.test\\.ts __tests__/api/messaging/route-auth-mapping\\.test\\.ts --maxWorkers=1\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^cmd /c \"pnpm -C apps/client exec vitest run __tests__/api/properties/property-id\\.route\\.test\\.ts __tests__/api/stores/store-id\\.route\\.test\\.ts __tests__/api/messaging/route-auth-mapping\\.test\\.ts --maxWorkers=1\"; Write-Output \"EXIT:\\$LASTEXITCODE\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^pnpm -C apps/client exec tsc --noEmit --pretty false; Set-Content -Path \"apps/client/tmp/tsc-exit\\.txt\" -Value \\$LASTEXITCODE$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^cmd /c \"pnpm -C apps/client exec tsc --noEmit --pretty false\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^\\./scripts/invoke-clean\\.ps1 -WorkingDirectory \\. -CommandLine \"pnpm -C apps/client exec vitest run __tests__/api/notifications/route\\.test\\.ts __tests__/api/user/compliance\\.route\\.test\\.ts --maxWorkers=1\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "1..$lines.Length": true,
    "ForEach-Object": true
  },
  "git.autoRepositoryDetection": "subFolders",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.defaultLocation": "view",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash",
      "icon": "terminal-git-bash"
    }
  },
  "chat.agent.sandbox.enabled": "on",
  "chat.agent.sandbox.allowNetwork": true,
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  }
}